@model KarmaShop.Models.PhieuMua
@{
    ViewData["Title"] = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cart = ViewBag.Cart as List<KarmaShop.Models.ChiTietPhieuMua>;
    var tongTamTinh = ViewBag.TongTien ?? 0;
    var defaultAddress = ViewBag.DefaultAddress as KarmaShop.Models.Sodiachi;

    var phiVanChuyen = 30000;
    var tongThanhToanBanDau = tongTamTinh + phiVanChuyen;
}

<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Thanh Toán</h1>
                <nav class="d-flex align-items-center">
                    <a href="/">Trang chủ<span class="lnr lnr-arrow-right"></span></a>
                    <a href="#">Xác nhận đơn hàng</a>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="cart_area">
    <div class="container">
        <div class="checkout-container">
            <div class="checkout-card">
                <h2 class="text-center mb-4">Xác Nhận Đơn Hàng</h2>

                <form asp-action="ThanhToan" asp-controller="PhieuMua" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="MaKhachHang" />

                    <input type="hidden" asp-for="TongTien" id="hiddenThanhTien" value="@tongThanhToanBanDau" />

                    <div class="row">
                        <div class="col-lg-7">
                            <h4>Thông tin nhận hàng</h4>
                            <hr />

                            @if (defaultAddress != null)
                            {
                                <input type="hidden" asp-for="TenNguoiNhan" value="@defaultAddress.Tennguoinhan" />
                                <input type="hidden" asp-for="SoDienThoaiNguoiNhan" value="@defaultAddress.Sdtnguoinhan" />
                                <input type="hidden" asp-for="DiaChiGiaoHang" value="@defaultAddress.Diachi" />
                                <input type="hidden" asp-for="EmailNguoiNhan" value="@Context.Session.GetString("Email")" />

                                <div class="form-group">
                                    <label>Họ và tên người nhận</label>
                                    <input type="text" class="form-control" value="@defaultAddress.Tennguoinhan" readonly />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 form-group">
                                        <label>Số điện thoại</label>
                                        <input type="tel" class="form-control" value="@defaultAddress.Sdtnguoinhan" readonly />
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label>Email</label>
                                        <input type="email" class="form-control" value="@Context.Session.GetString("Email")" readonly />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Địa chỉ giao hàng</label>
                                    <textarea class="form-control" rows="3" readonly>@defaultAddress.Diachi, @defaultAddress.MaPhuongNavigation?.TenPhuong, @defaultAddress.MaQuanNavigation?.TenQuan, @defaultAddress.MaTinhNavigation?.TenTinh</textarea>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    Bạn chưa có địa chỉ mặc định. Vui lòng thêm địa chỉ trong <a href="/TaiKhoan/Sodiachi">Sổ địa chỉ</a>.
                                </div>
                            }

                            <div class="form-group">
                                <label>Ghi chú đơn hàng</label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Lưu ý cho người giao hàng..."></textarea>
                            </div>

                        </div>

                        <!-- ==================== TÓM TẮT ĐƠN HÀNG ==================== -->
                        <div class="col-lg-5">
                            <div class="order-summary">
                                <h4>Đơn hàng (@(cart?.Count ?? 0) sản phẩm)</h4>
                                <hr />

                                @if (cart != null)
                                {
                                    foreach (var item in cart)
                                    {
                                        <div class="product-item">
                                            <img src="~/img/@item.MaSanPhamNavigation?.MaDongSanPham/Avatar/@item.MaSanPhamNavigation?.AnhDaiDien"
                                                 alt="Sản phẩm" />
                                            <div style="flex:1">
                                                <strong>@item.MaSanPhamNavigation?.TenSanPham</strong><br />
                                                <small>Size: @item.MaSize | SL: @item.SoLuong</small>
                                            </div>
                                            <div class="text-right">
                                                <strong>@((item.DonGia * item.SoLuong)?.ToString("#,##0"))₫</strong>
                                            </div>
                                        </div>
                                    }
                                }

                                <hr />
                                <div class="d-flex justify-content-between">
                                    <strong>Tạm tính</strong>
                                    <span id="tamTinhText">@tongTamTinh.ToString("#,##0")₫</span>
                                </div>

                                <div class="d-flex justify-content-between mt-2">
                                    <strong>Phí vận chuyển</strong>
                                    <span>@phiVanChuyen.ToString("#,##0")₫</span>
                                </div>

                                <div class="d-flex justify-content-between mt-2" id="giamGiaRow" style="display: none;">
                                    <strong>Giảm giá Voucher</strong>
                                    <strong id="giamGiaText" class="text-success"></strong>
                                </div>

                                <div class="d-flex justify-content-between mt-3 total-price">
                                    <strong>Tổng thanh toán</strong>
                                    <strong id="thanhTienDisplay">@tongThanhToanBanDau.ToString("#,##0")₫</strong>
                                </div>
                            </div>

                            <!-- ==================== PHƯƠNG THỨC THANH TOÁN ==================== -->
                            <div class="payment-method-section mt-4">
                                <h4>Phương thức thanh toán</h4>
                                <hr />
                                @if (ViewBag.PhuongThucTT != null)
                                {
                                    foreach (var pttt in (List<KarmaShop.Models.PhuongThucThanhToan>)ViewBag.PhuongThucTT)
                                    {
                                        <div class="payment_item d-flex align-items-center mb-3">
                                            <input type="radio"
                                                   name="MaPttt"
                                                   value="@pttt.MaPttt"
                                                   id="pttt_@pttt.MaPttt"
                                                   required
                                                   onchange="toggleBankInfo(this)" />
                                            <label for="pttt_@pttt.MaPttt" class="ml-2 mb-0" style="font-size:16px">
                                                @if (pttt.TenPttt.ToLower().Contains("cod"))
                                                {
                                                    <i class="fa fa-truck mr-1 text-black"></i>
                                                }
                                                else if (pttt.TenPttt.ToLower().Contains("chuyển khoản"))
                                                {
                                                    <i class="fa fa-university mr-1 text-black"></i>
                                                }
                                                @pttt.TenPttt
                                            </label>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- Voucher -->
                            <div class="form-group mt-4">
                                <label>Mã giảm giá</label>

                                <div class="voucher-input d-flex">
                                    <input type="text" asp-for="MaVoucher" id="MaVoucher"
                                           class="form-control" placeholder="Nhập mã voucher" autocomplete="off" />
                                    <button type="button" class="btn btn-outline-primary" id="btnApDung">Áp dụng</button>
                                </div>

                                <button type="button" class="btn btn-link text-primary mt-2 p-0" id="btnSuggestVoucher">
                                    <i class="fas fa-gift"></i> Xem voucher gợi ý cho bạn
                                </button>

                                <div id="voucherSuggestions" class="voucher-suggestions mt-3" style="display: none;">
                                </div>

                                <div id="voucherMsg" class="mt-2"></div>
                            </div>

                            <button type="submit" class="primary-btn w-100 mt-4">
                                Thanh Toán
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const phiShip = 30000;
        const tamTinhGoc = @tongTamTinh;

        function toggleBankInfo(radio) {
            const bankInfo = document.getElementById('bankTransferInfo');
            const tenPTTT = radio.nextElementSibling ? radio.nextElementSibling.textContent.trim() : '';

            if (bankInfo) {
                if (tenPTTT.includes("Chuyển khoản") || tenPTTT.includes("Ngân hàng")) {
                    bankInfo.style.display = 'block';
                } else {
                    bankInfo.style.display = 'none';
                }
            }
        }

        window.onload = function() {
            const checkedRadio = document.querySelector('input[name="MaPttt"]:checked');
            if (checkedRadio) {
                toggleBankInfo(checkedRadio);
            }
        };

        document.getElementById('btnApDung').addEventListener('click', function () {
            const voucherCode = document.getElementById('MaVoucher').value.trim();

            if (!voucherCode) {
                showVoucherMessage("Vui lòng nhập mã voucher", "danger");
                return;
            }

            $.ajax({
                url: '/PhieuMua/KiemTraVoucher',
                type: 'POST',

                data: { maVoucher: voucherCode, tongTamTinh: tamTinhGoc },
                success: function (response) {
                    if (response.success) {

                        let tongThanhToanMoi = (tamTinhGoc - response.giamGia) + phiShip;
                        if(tongThanhToanMoi < 0) tongThanhToanMoi = 0;

                        document.getElementById('giamGiaRow').style.display = 'flex';
                        document.getElementById('giamGiaText').textContent = '-' + response.giamGia.toLocaleString('vi-VN') + '₫';
                        document.getElementById('thanhTienDisplay').textContent = tongThanhToanMoi.toLocaleString('vi-VN') + '₫';
                        document.getElementById('hiddenThanhTien').value = tongThanhToanMoi;

                        showVoucherMessage(response.message, "success");
                    } else {
                        showVoucherMessage(response.message, "danger");
                        resetVoucherDisplay();
                    }
                }
            });
        });

        function showVoucherMessage(text, type) {
            const msgElement = document.getElementById('voucherMsg');
            msgElement.innerHTML = `<span class="text-${type}">${text}</span>`;
        }

        function resetVoucherDisplay() {
            const defaultTotal = tamTinhGoc + phiShip;
            document.getElementById('giamGiaRow').style.display = 'none';
            document.getElementById('thanhTienDisplay').textContent = defaultTotal.toLocaleString('vi-VN') + '₫';
            document.getElementById('hiddenThanhTien').value = defaultTotal;
        }

        $('#btnSuggestVoucher').click(function () {
            const suggestionsBox = $('#voucherSuggestions');

            if (suggestionsBox.is(':visible')) {
                suggestionsBox.slideUp();
                return;
            }

            suggestionsBox.html('<div class="text-center py-3"><i class="fas fa-spinner fa-spin"></i> Đang tải voucher...</div>');
            suggestionsBox.slideDown();

            $.ajax({
                url: '/PhieuMua/GoiYVoucher',
                type: 'GET',

                data: { tongTien: tamTinhGoc },
                success: function (response) {
                    if (response.success && response.vouchers && response.vouchers.length > 0) {
                        let html = '<h6 class="mb-2"><i class="fas fa-gift"></i> Voucher phù hợp với bạn:</h6>';

                        response.vouchers.forEach(v => {
                                   html += `
                                    <div class="voucher-item" data-code="${v.maVoucher}">
                                        <div class="d-flex justify-content-between">
                                            <strong>${v.maVoucher}</strong>
                                            <span class="text-success">${v.giamGiaText}</span>
                                        </div>
                                        <small class="text-muted">${v.dieuKien || ''}</small><br>
                                        ${v.hanSuDung ? `<small class="text-danger">HSD: ${v.hanSuDung}</small>` : ''}
                                    </div>`;
                        });

                        suggestionsBox.html(html);

                        $('.voucher-item').click(function () {
                            const code = $(this).data('code');
                            $('#MaVoucher').val(code);
                            suggestionsBox.slideUp();
                            $('#btnApDung').trigger('click');
                        });
                    } else {
                        suggestionsBox.html('<div class="alert alert-info">Hiện tại không có voucher nào phù hợp với đơn hàng của bạn.</div>');
                    }
                },
                error: function () {
                    suggestionsBox.html('<div class="alert alert-danger">Lỗi khi tải voucher gợi ý.</div>');
                }
            });
        });
    </script>
}
