@model List<KarmaShop.Models.ViewModels.SanPhamHomeViewModel>

<section style="padding: 30px 0;">
<div class="container position-relative">
    <h2 class="text-center">HOT PRODUCTS</h2>
    <div id="productSlider" class="row flex-row flex-nowrap overflow-auto">
        @foreach (var spHomeView in Model)
        {
            <div class="product-card">
                <div class="product-image">
                    <a href="@Url.Action("HienThiSanPham", "SanPham",
                                       new { madongsanpham = spHomeView.sp.MaDongSanPham,
                                             masp = spHomeView.sp.MaSanPham })">
                        <img src="/img/@spHomeView.sp.MaDongSanPham/Avatar/@spHomeView.sp.AnhDaiDien"
                             alt="Product Image" />
                        @if (spHomeView.sp.TrangThai == true)
                        {
                            <p class="text-top-right"><strong>HOT</strong></p>
                        }
                    </a>
                </div>
                <div class="product-info">
                    <h5 class="mt-2" style="text-align:left">
                        @(spHomeView.sp.MaDongSanPhamNavigation?.TenDongSanPham ?? "")
                        @(spHomeView.sp.MaMauNavigation?.TenMau ?? "")
                    </h5>
                    <h5 style="text-align:left;">
                        @(spHomeView.sp.MaDongSanPhamNavigation?.GiaBan != null
                            ? spHomeView.sp.MaDongSanPhamNavigation.GiaBan.Value.ToString("#,##0") + " đ"
                            : "N/A")
                    </h5>
                </div>
                <a class="btn btn-primary view-details-btn"
                   href="@Url.Action("HienThiSanPham", "SanPham",
                     new { madongsanpham = spHomeView.sp.MaDongSanPham,
                           masp = spHomeView.sp.MaSanPham })">
                    View Details
                </a>
            </div>
        }
    </div>

    <!-- Navigation Buttons -->
    <button class="btn btn-primary" id="prevBtn">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button class="btn btn-primary" id="nextBtn">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>
</section>


<style>
    .product-card {
        position: relative;
        flex: 0 0 auto;
        width: 250px;
        height: 370px;
        margin-right: 20px;
    }

    .product-image {
        width: 100%;
        height: 250px;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .view-details-btn {
        position: absolute;
        bottom: 10px;
        left: 50%;
        width: 100%;
        transform: translateX(-50%);
        display: none;
        background-color: #ffffff;
        border: 1px solid grey;
        color: #252a2b;
    }

        .view-details-btn:hover {
            background-color: #1b4ea0;
            color: #ffffff;
        }

    .product-card:hover .view-details-btn {
        display: block;
    }

    .text-top-right {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #fdd464;
    }

    #prevBtn,
    #nextBtn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
        background-color: #ffffff;
        color: #252a2b;
        border-color: #ffffff;
    }

        #prevBtn:hover,
        #nextBtn:hover {
            background-color: #1b4ea0;
        }

    #prevBtn {
        left: 10px;
    }

    #nextBtn {
        right: 10px;
    }

    #productSlider {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .product-info {
        margin-bottom: 10px;
    }
</style>

<script>
    (function () {
        var productSlider = document.getElementById('productSlider');
        var prevBtn = document.getElementById('prevBtn');
        var nextBtn = document.getElementById('nextBtn');

        if (!productSlider || !prevBtn || !nextBtn) return;

        var cardEl = document.querySelector('.product-card');
        if (!cardEl) return;

        var scrollPosition = 0;
        var manualScroll = false;
        var cardWidth = cardEl.offsetWidth;

        function nextSlide() {
            if (scrollPosition < productSlider.scrollWidth - productSlider.clientWidth) {
                scrollPosition += cardWidth;
            } else {
                scrollPosition = 0;
            }
            productSlider.scroll({ left: scrollPosition, behavior: 'smooth' });
        }

        prevBtn.addEventListener('click', function () {
            if (scrollPosition > 0) {
                scrollPosition -= cardWidth;
                productSlider.scroll({ left: scrollPosition, behavior: 'smooth' });
            }
        });

        nextBtn.addEventListener('click', function () {
            nextSlide();
        });

        setInterval(function () {
            if (!manualScroll) nextSlide();
        }, 5000);

        productSlider.addEventListener('scroll', function () {
            scrollPosition = productSlider.scrollLeft;
            manualScroll = true;
            setTimeout(function () { manualScroll = false; }, 100);
        });
    })();
</script>
