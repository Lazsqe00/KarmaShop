@model List<KarmaShop.Models.ViewModels.SanPhamHomeViewModel>

<style>
    .exclusive-deal-area { min-height: unset !important; }
    .exclusive-right .single-exclusive-slider { display: block; }
</style>
<section class="exclusive-deal-area">
    <div class="container-fluid">
        <div class="row justify-content-center align-items-center">
            <!-- Countdown Timer -->
            <div class="col-lg-6 no-padding exclusive-left">
                <div class="row clock_sec clockdiv" id="clockdiv">
                    <div class="col-lg-12">
                        <h1>Exclusive 20% Discount – Limited Time Only – Use Code <span style="color:#ff3d00;">SALE20</span></h1>
                        <p>Enjoy 20% off your purchase with our special voucher.</p>
                    </div>
                    <div class="col-lg-12">
                        <div class="row clock-wrap">
                            <div class="col clockinner1 clockinner">
                                <h1 class="days">0</h1>
                                <span class="smalltext">Days</span>
                            </div>
                            <div class="col clockinner clockinner1">
                                <h1 class="hours">23</h1>
                                <span class="smalltext">Hours</span>
                            </div>
                            <div class="col clockinner clockinner1">
                                <h1 class="minutes">0</h1>
                                <span class="smalltext">Mins</span>
                            </div>
                            <div class="col clockinner clockinner1">
                                <h1 class="seconds">0</h1>
                                <span class="smalltext">Secs</span>
                            </div>
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("SanPhamTheoLoai", "SanPham")" class="primary-btn">Shop Now</a>
            </div>

            <!-- Product Slider -->
            <div class="col-lg-6 no-padding exclusive-right">
                <div class="active-exclusive-product-slider">
                    @foreach (var item in Model)
                    {
                        <div class="single-exclusive-slider">
                            <img class="img-fluid" src="~/img/@item.sp.MaDongSanPham/Avatar/@item.sp.AnhDaiDien" alt="@item.TenSanPhamFull">
                            <div class="product-details">
                                <div class="price">
                                    <h6>@((item.GiaHienThi * 0.8m)?.ToString("#,##0")) đ</h6>
                                    <h6 class="l-through">@(item.GiaHienThi?.ToString("#,##0") + " đ")</h6>
                                </div>
                                <h4>@item.TenSanPhamFull</h4>
                                <div class="add-bag d-flex align-items-center justify-content-center">
                                    <a class="add-btn" href="@Url.Action("HienThiSanPham", "SanPham", new { madongsanpham = item.sp.MaDongSanPham, masp = item.sp.MaSanPham })"><span class="ti-bag"></span></a>
                                    <span class="add-text text-uppercase">Add to Bag</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {
        if ($('.active-exclusive-product-slider').length) {
            $('.active-exclusive-product-slider').owlCarousel({
                loop: true,
                margin: 0,
                nav: true,
                dots: false,
                autoplay: true,
                autoplayTimeout: 5000,
                autoplayHoverPause: true,
                navText: ["<span class='ti-arrow-left'></span>", "<span class='ti-arrow-right'></span>"],
                responsive: {
                    0: { items: 1 },
                    600: { items: 1 },
                    1000: { items: 1 }
                }
            });
        }
    });

    (function () {
        function startCountdown(durationHours) {
            var timer = durationHours * 60 * 60;
            var daysEl = document.querySelector('.days');
            var hoursEl = document.querySelector('.hours');
            var minsEl = document.querySelector('.minutes');
            var secsEl = document.querySelector('.seconds');

            if (!daysEl || !hoursEl || !minsEl || !secsEl) return;

            setInterval(function () {
                var days = Math.floor(timer / (24 * 3600));
                var hours = Math.floor((timer % (24 * 3600)) / 3600);
                var minutes = Math.floor((timer % 3600) / 60);
                var seconds = Math.floor(timer % 60);

                daysEl.textContent = days;
                hoursEl.textContent = hours;
                minsEl.textContent = minutes;
                secsEl.textContent = seconds;

                if (timer > 0) timer--;
            }, 1000);
        }

        startCountdown(23);
    })();
</script>
