@model KarmaShop.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Login/Register</h1>
            </div>
        </div>
    </div>
</section>

<section class="login_box_area section_gap">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <img class="img-fluid" src="@Url.Content("~/karma-master/img/login.jpg")" alt="">
                    <div class="hover">
                        <h4>New to our website?</h4>
                        <p>There are advances being made in science and technology everyday, and a good example of this is the</p>
                        @Html.ActionLink("Create an Account", "Register", "Account", null, new { @class = "primary-btn" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner">
                    <h3>Log in to enter</h3>
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "row login_form", id = "contactForm", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="backToPage" value="@ViewBag.backToPage" />
                        <div class="col-md-12">
                            @Html.ValidationSummary(true, "", new { @class = "msg_error" })
                        </div>
                        <div class="col-md-12 form-group">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email", onfocus = "this.placeholder=''", onblur = "this.placeholder='Email'" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12 form-group">
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", @required = "required", placeholder = "Password", onfocus = "this.placeholder=''", onblur = "this.placeholder='Password'" })
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-12 form-group">
                            <button type="submit" class="primary-btn">Log In</button>
                        </div>

                    }

                </div>
            </div>
        </div>
    </div>
</section>


<style>
    .msg_error {
        color: #D8000C;
        background-color: #FFBABA;
        padding: 10px;
    }
</style>

