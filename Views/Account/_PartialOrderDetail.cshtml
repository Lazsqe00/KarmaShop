@model KarmaShop.Models.PhieuMua

<div class="order-detail">
    <div class="row mb-3">
        <div class="col-md-6">
            <h5>Mã đơn hàng: <strong>#@Model.MaPhieuMua</strong></h5>
            <p><strong>Ngày đặt:</strong> @Model.NgayDat?.ToString("dd/MM/yyyy")</p>   
        </div>
        <div class="col-md-6 text-end">
            <span class="badge-status
                @(Model.TinhTrang == "Đã giao hàng" ? "status-hoanthanh" :
                                    Model.TinhTrang == "Đang giao hàng" ? "status-danggiao" :
                                    Model.TinhTrang == "Từ chối" ? "status-tuchoi" : "status-cho")">
                @Model.TinhTrang
            </span>
        </div>
    </div>

    <hr />
    <h6>Thông tin người nhận</h6>
    <div class="row mb-4">
        <div class="col-md-4">
            <strong>Tên người nhận:</strong><br>
            @Model.TenNguoiNhan
        </div>
        <div class="col-md-4">
            <strong>Số điện thoại:</strong><br>
            @Model.SoDienThoaiNguoiNhan
        </div>
        <div class="col-md-4">
            <strong>Địa chỉ giao hàng:</strong><br>
            @Model.DiaChiGiaoHang
        </div>
    </div>

    <h6>Danh sách sản phẩm</h6>
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Sản phẩm</th>
                <th>Màu</th>
                <th>Size</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ct in Model.ChiTietPhieuMuas)
            {
                var thanhTien = ct.SoLuong * ct.DonGia;
                <tr>
                    <td>
                        <img src="~/img/@ct.MaSanPhamNavigation.MaDongSanPhamNavigation.MaDongSanPham/Avatar/@ct.MaSanPhamNavigation.AnhDaiDien"
                             width="80"
                             height="80"
                             style="object-fit:cover;border-radius:10px;" />
                    </td>
                    <td>@ct.MaSanPhamNavigation?.MaDongSanPhamNavigation?.TenDongSanPham</td>
                    <td>@ct.MaSanPhamNavigation?.MaMauNavigation?.TenMau</td>
                    <td>@ct.MaSizeNavigation?.TenSize</td>
                    <td class="text-center">@ct.SoLuong</td>
                    <td class="text-end">@ct.DonGia?.ToString("N0") ₫</td>
                    <td class="text-end"><strong>@thanhTien?.ToString("N0") ₫</strong></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row mt-4">
        <div class="col-md-8"></div>
        <div class="col-md-4 text-end">
            @{
                decimal sum = 0;

                foreach (var ct in Model.ChiTietPhieuMuas)
                {
                    decimal thanhTien = (ct.SoLuong ?? 0) * (ct.DonGia ?? 0);

                    sum += thanhTien;
                }
            }
             
            <tr>
                <td><strong>Tổng tiền hàng:</strong></td>
                <td><strong>@sum.ToString("N0") ₫</strong></td>
            </tr>
            <br />
            <tr>
                <td><strong>Phí vận chuyển:</strong></td>
                <td><strong>-30.000 ₫</strong></td>  
            </tr>
           
            @if (!string.IsNullOrEmpty(Model.MaVoucher))
            {
                <br />
                <small class="text-success">
                    Đã áp dụng mã giảm giá <strong>@Model.MaVoucher</strong>
                </small>
            }
            <br />
            <tr>
                <td><strong>Tổng cộng:</strong></td>
                <td><strong>@Model.TongTien?.ToString("N0") ₫</strong></td>
            </tr>
            
        </div>
    </div>
</div>