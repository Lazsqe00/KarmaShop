@model KarmaShop.Models.KhachHang
@{
    Layout = "_ThuNganLayout";

    // Phân loại hạng dựa theo mốc tiền tích lũy mới
    decimal soTienTichLuy = Model.TongChi ?? 0;
    string hangHienTai = "Thành Viên";
    string mauBadge = "bg-light text-secondary";
    string iconHang = "mdi-account-card-details";

    if (soTienTichLuy >= 8000000) { hangHienTai = "Kim Cương"; mauBadge = "bg-danger text-white"; iconHang = "mdi-diamond"; }
    else if (soTienTichLuy >= 5000000) { hangHienTai = "Bạch Kim"; mauBadge = "bg-info text-dark"; iconHang = "mdi-medal"; }
    else if (soTienTichLuy >= 3000000) { hangHienTai = "Vàng"; mauBadge = "bg-warning text-dark"; iconHang = "mdi-crown"; }
    else if (soTienTichLuy >= 500000) { hangHienTai = "Bạc"; mauBadge = "bg-secondary text-white"; iconHang = "mdi-award"; }
}

<div class="d-flex align-items-center mb-4">
    <a href="javascript:history.back()" class="btn btn-white shadow-sm rounded-circle me-3 bg-white" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
        <i class="mdi mdi-arrow-left text-primary fs-4"></i>
    </a>
    <h3 class="fw-bold mb-0 text-dark">Hồ sơ khách hàng: @($"KH{Model.MaKhachHang:D2}")</h3>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
            <div class="card-body p-4 text-center">
                <div class="mx-auto mb-3 position-relative" style="width: 100px;">
                    <div class="bg-gradient-primary-custom rounded-circle d-flex align-items-center justify-content-center mx-auto shadow" style="width: 100px; height: 100px;">
                        <i class="mdi mdi-account fs-1 text-white"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-2">@Model.TenKhachHang</h4>

                <p class="badge @mauBadge px-3 py-2 fs-6 mb-2 fw-bold">
                    <i class="mdi @iconHang me-1"></i>Hạng @hangHienTai
                </p>
                <small class="text-muted d-block mb-4">Tích lũy chi tiêu: <strong class="text-success">@string.Format("{0:N0}₫", soTienTichLuy)</strong></small>

                <div class="text-start border-top pt-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="mdi mdi-email-outline fs-5 me-3 text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Email</small>
                            <span class="fw-semibold">@Model.Email</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="mdi mdi-phone-outline fs-5 me-3 text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Số điện thoại</small>
                            <span class="fw-semibold">@Model.SoDienThoai</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="mdi mdi-gender-male-female fs-5 me-3 text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Giới tính</small>
                            <span class="fw-semibold">@Model.GioiTinh</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-map-marker-outline fs-5 me-3 text-muted"></i>
                        <div>
                            <small class="text-muted d-block">Địa chỉ</small>
                            <span class="fw-semibold">@Model.DiaChi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 15px;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="mdi mdi-gift-outline me-2 text-primary"></i>Ưu đãi hạng @hangHienTai</h5>
                <ul class="ps-3 mb-0 text-secondary small" style="line-height: 1.8;">
                    @if (hangHienTai == "Thành Viên")
                    {
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Voucher miễn phí vận chuyển.</li>
                    }
                    else if (hangHienTai == "Bạc")
                    {
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Hưởng đầy đủ ưu đãi hạng Thành Viên.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Mã giảm giá độc quyền dịp lễ lớn.</li>
                    }
                    else if (hangHienTai == "Vàng")
                    {
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Hưởng đầy đủ ưu đãi hạng Bạc.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i><strong>Giảm trực tiếp 5%</strong> đối với đơn từ 350.000đ.</li>
                    }
                    else if (hangHienTai == "Bạch Kim")
                    {
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Hưởng đầy đủ ưu đãi hạng Vàng.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i><strong>Giảm trực tiếp 10%</strong> đối với đơn từ 550.000đ.</li>
                    }
                    else if (hangHienTai == "Kim Cương")
                    {
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Hưởng đầy đủ ưu đãi hạng Bạch Kim.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i><strong>Giảm trực tiếp 12%</strong> đối với đơn từ 800.000đ.</li>
                        <li><i class="mdi mdi-check-circle-outline text-success me-1"></i>Voucher giảm giá 20% giá trị sản phẩm trong dịp sinh nhật.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 15px;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0"><i class="mdi mdi-history me-2 text-primary"></i>Lịch sử đơn hàng</h5>
                    <span class="badge bg-light text-dark">@(Model.PhieuMuas?.Count ?? 0) đơn hàng</span>
                </div>

                @if (Model.PhieuMuas != null && Model.PhieuMuas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light small fw-bold">
                                <tr>
                                    <th class="ps-3">Mã HD</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.PhieuMuas)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-primary">@($"HD{h.MaPhieuMua:D2}")</td>
                                        <td><i class="mdi mdi-calendar-blank me-1 text-muted"></i>@h.NgayDat?.ToString("dd/MM/yyyy")</td>
                                        <td class="text-danger fw-bold">@string.Format("{0:N0}₫", h.TongTien)</td>
                                        <td class="text-center">
                                            <span class="badge bg-soft-success text-success border-success-subtle px-3 py-2">
                                                @h.TinhTrang
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 opacity-50">
                        <i class="mdi mdi-cart-off fs-1 mb-3 d-block"></i>
                        <p class="mb-0">Khách hàng này chưa có giao dịch nào.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section styles {
    <style>
        .bg-soft-primary {
            background-color: #f0ebff;
        }

        .bg-soft-success {
            background-color: #e8fadf;
        }

        .table thead th {
            border-top: none;
            padding: 12px;
        }

        .table td {
            padding: 15px 12px;
        }
    </style>
}