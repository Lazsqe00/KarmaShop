@model KarmaShop.Models.PhieuMua

@{
    Layout = "_ThuNganLayout";

    decimal tongTienHang = 0;
    decimal chietKhau = 0;
    decimal tongThanhToan = 0;
    decimal tienKhachDua = 0;
    decimal tienThua = 0;

    if (Model != null)
    {
        foreach (var ct in Model.ChiTietPhieuMuas)
        {
            decimal gia = (decimal)(ct.DonGia ?? 0);
            int sl = ct.SoLuong ?? 0;
            tongTienHang += (gia * sl);
        }

        if (Model.TinhTrang == "Đã thanh toán")
        {
            if (Model.MaKhachHangNavigation != null)
            {
                decimal tc = Model.MaKhachHangNavigation.TongChi ?? 0m;
                string hangHienTai = "Thành Viên";
                if (tc >= 8000000m) hangHienTai = "Kim Cương";
                else if (tc >= 5000000m) hangHienTai = "Bạch Kim";
                else if (tc >= 3000000m) hangHienTai = "Vàng";
                else if (tc >= 500000m) hangHienTai = "Bạc";

                if (hangHienTai == "Vàng" && tongTienHang >= 350000m) chietKhau = tongTienHang * 0.05m;
                else if (hangHienTai == "Bạch Kim" && tongTienHang >= 550000m) chietKhau = tongTienHang * 0.10m;
                else if (hangHienTai == "Kim Cương" && tongTienHang >= 800000m) chietKhau = tongTienHang * 0.12m;
            }

            tongThanhToan = tongTienHang - chietKhau;

            tienKhachDua = tongThanhToan;
            tienThua = 0;
        }
        else
        {
            chietKhau = 0;
            tongThanhToan = 0;
            tienKhachDua = 0;
            tienThua = 0;
        }
    }
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-gradient-primary-custom text-white d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 45px; height: 45px; box-shadow: 0 4px 10px rgba(0,0,0,0.15)">
            <i class="mdi mdi-printer fs-4"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0 text-dark">Xuất hóa đơn bán hàng</h3>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 15px;">
    <div class="row justify-content-center mb-5 no-print">
        <div class="col-md-6">
            <form method="get" class="input-group">
                <span class="input-group-text bg-light border-0"><i class="mdi mdi-magnify text-muted"></i></span>
                <input type="text" name="id" class="form-control border-0 bg-light py-2" placeholder="Nhập mã hóa đơn (VD: 1, 2...)" value="@Context.Request.Query["id"]">
                <button type="submit" class="btn btn-gradient-primary-custom px-4 fw-bold">Tìm hóa đơn</button>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <div id="invoice-print" class="p-4 mx-auto border shadow-sm rounded bg-white" style="max-width: 900px; color: #000; font-family: 'Times New Roman', serif;">

            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1" style="text-transform: uppercase; letter-spacing: 2px; font-size: 24px;">HOÁ ĐƠN BÁN HÀNG</h2>
                <p class="mb-1">Ngày @Model.NgayDat?.Day Tháng @Model.NgayDat?.Month Năm @Model.NgayDat?.Year</p>
                <p class="mb-0">Số hoá đơn: <span class="fw-bold">@($"HD{Model.MaPhieuMua:D2}")</span></p>
            </div>

            <div class="row mb-4" style="font-size: 0.95rem; line-height: 1.8;">
                <div class="col-7">
                    <div>Họ tên khách hàng: <span class="fw-bold">@(Model.MaKhachHangNavigation?.TenKhachHang ?? "Khách vãng lai")</span></div>
                    <div>Địa chỉ giao hàng: <span>@(Model.MaKhachHangNavigation?.DiaChi ?? "Chưa có")</span></div>
                    <div>Số điện thoại: <span class="fw-bold">@(Model.MaKhachHangNavigation?.SoDienThoai ?? "Chưa có")</span></div>
                    <div>Hình thức thanh toán: <span class="fw-bold">@(Model.MaPtttNavigation?.TenPttt ?? "Tiền mặt")</span></div>
                </div>
                <div class="col-5">
                    <div>Địa chỉ: 53/24 Nguyễn Thiện Thuật, Lộc Thọ, Nha Trang</div>
                    <div>Số điện thoại: 0347665000</div>
                    <div>Website: http://www.ericshoes.vn</div>
                </div>
            </div>

            <table class="table table-bordered border-dark align-middle mb-3" style="border-color: #000 !important;">
                <thead class="text-center fw-bold" style="background-color: #f0f0f0;">
                    <tr>
                        <th style="width: 40px;">STT</th>
                        <th style="width: 40%;">Tên sản phẩm</th>
                        <th style="width: 12%;">Màu sắc</th>
                        <th style="width: 10%;">Size</th>
                        <th style="width: 13%;">Đơn giá</th>
                        <th style="width: 10%;">Số lượng</th>
                        <th style="width: 15%;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var ct in Model.ChiTietPhieuMuas)
                    {
                        <tr>
                            <td class="text-center">@(i++)</td>
                            <td class="ps-2">@ct.MaSanPhamNavigation?.TenSanPham</td>
                            <td class="text-center">@(ct.MaSanPhamNavigation?.MaMauNavigation?.TenMau ?? "Chưa rõ")</td>
                            <td class="text-center">@(ct.MaSizeNavigation?.TenSize ?? (ct.MaSize != null ? ct.MaSize.ToString() : "Chưa rõ"))</td>
                            <td class="text-end pe-2">@string.Format("{0:N0}", ct.DonGia ?? 0)</td>
                            <td class="text-center">@ct.SoLuong</td>
                            <td class="text-end pe-2 fw-bold">@string.Format("{0:N0}", (ct.DonGia ?? 0) * (ct.SoLuong ?? 0))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="width: 100%; margin-top: 10px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <div style="width: 70%; text-align: right; font-weight: bold;">Tổng tiền hàng:</div>
                    <div style="width: 30%; text-align: right; font-weight: bold;">@string.Format("{0:N0}₫", tongTienHang)</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <div style="width: 70%; text-align: right; font-weight: bold; color: green;">Chiết khấu giảm giá hạng:</div>
                    <div style="width: 30%; text-align: right; font-weight: bold; color: green;">@string.Format("-{0:N0}₫", chietKhau)</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; background-color: #f8f9fa; padding: 8px 0;">
                    <div style="width: 70%; text-align: right; font-weight: bold; font-size: 16px;">Tổng cộng tiền thanh toán:</div>
                    <div style="width: 30%; text-align: right; font-weight: bold; font-size: 16px; color: red;">@string.Format("{0:N0}₫", tongThanhToan)</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <div style="width: 70%; text-align: right; font-weight: bold;">Tiền khách đưa:</div>
                    <div style="width: 30%; text-align: right;">@string.Format("{0:N0}₫", tienKhachDua)</div>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <div style="width: 70%; text-align: right; font-weight: bold;">Tiền thừa trả lại khách:</div>
                    <div style="width: 30%; text-align: right;">@string.Format("{0:N0}₫", tienThua)</div>
                </div>
            </div>

            <div class="row mt-5 text-center">
                <div class="col-6">
                    <p class="fw-bold mb-1">Khách hàng</p>
                    <p class="small text-muted">(Ký, họ tên)</p>
                </div>
                <div class="col-6">
                    <p class="fw-bold mb-1">Nhân viên bán hàng</p>
                    <p class="small text-muted">(Ký, họ tên)</p>
                    <div class="mt-4 fw-bold text-primary">@(Context.Session.GetString("Email") ?? "Thu ngân hệ thống")</div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 no-print">
            <button class="btn btn-gradient-primary-custom px-5 py-2 rounded-pill shadow" onclick="window.print()">
                <i class="mdi mdi-printer me-2"></i> IN HÓA ĐƠN NGAY
            </button>
        </div>
    }
    else if (!string.IsNullOrEmpty(Context.Request.Query["id"]))
    {
        <div class="text-center py-5">
            <i class="mdi mdi-file-search-outline text-muted" style="font-size: 5rem;"></i>
            <p class="text-muted mt-3">Không tìm thấy hóa đơn mã số: <b>@Context.Request.Query["id"]</b></p>
        </div>
    }
    else
    {
        <div class="text-center py-5 opacity-50">
            <i class="mdi mdi-file-document-outline" style="font-size: 5rem;"></i>
            <p class="mt-2">Vui lòng nhập mã số hóa đơn để hiển thị bản in</p>
        </div>
    }
</div>

@section styles {
    <style>
        .italic {
            font-style: italic;
        }

        .bg-gradient-primary-custom {
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            border: none;
            color: white;
        }

      
        #invoice-print table th, #invoice-print table td {
            border: 1px solid #333 !important;
        }

      
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 0mm !important;
            }
            html, body {
                background-color: #fff !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 210mm !important;
                height: 297mm !important;
                visibility: hidden !important; 
            }
            #invoice-print {
                visibility: visible !important; 
                display: block !important;
                position: absolute !important;
                top: 15mm !important; 
                left: 50% !important;
                transform: translateX(-50%) scale(0.92); 
                transform-origin: top center;
                width: 100% !important;
                max-width: 180mm !important;
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }
                
                #invoice-print * {
                    visibility: visible !important;
                    color: #000 !important;
                }
                
                #invoice-print table th, #invoice-print table td {
                    border: 1px solid #000 !important;
                }
            
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
}