@model KarmaShop.Models.PhieuMua
@{
    Layout = "_ThuNganLayout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-gradient-primary-custom text-white d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 45px; height: 45px; box-shadow: 0 4px 10px rgba(0,0,0,0.15)">
            <i class="mdi mdi-printer fs-4"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0 text-dark">Xuất hóa đơn bán hàng</h3>
            <small class="text-muted fw-bold">TN_BM2 — BIỂU MẪU XUẤT HÓA ĐƠN</small>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 bg-white" style="border-radius: 15px;">
    <div class="row justify-content-center mb-5 no-print">
        <div class="col-md-6">
            <form method="get" class="input-group">
                <span class="input-group-text bg-light border-0"><i class="mdi mdi-magnify text-muted"></i></span>
                <input type="text" name="id" class="form-control border-0 bg-light py-2" placeholder="Nhập mã hóa đơn (VD: 1, 2...)" value="@Context.Request.Query["id"]">
                <button type="submit" class="btn btn-gradient-primary-custom px-4 fw-bold">Tìm hóa đơn</button>
            </form>
        </div>
    </div>

    @if (Model != null)
    {
        <div id="invoice-print" class="p-4 mx-auto border shadow-sm rounded bg-white" style="max-width: 850px; color: #000; font-family: 'Times New Roman', serif;">

            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1" style="text-transform: uppercase; letter-spacing: 2px;">Hoá đơn bán hàng</h2>
                <p class="mb-1 italic">Ngày @Model.NgayDat?.Day Tháng @Model.NgayDat?.Month Năm @Model.NgayDat?.Year</p>
                <p class="mb-0">Số hoá đơn: <span class="fw-bold text-danger">@($"HD{Model.MaPhieuMua:D4}")</span></p>
            </div>

            <div class="row mb-4" style="font-size: 1.05rem; line-height: 1.8;">
                <div class="col-7 border-end">
                    <div>Họ tên khách hàng: <span class="fw-bold">@Model.MaKhachHangNavigation?.TenKhachHang</span></div>
                    <div>Địa chỉ giao hàng: <span class="italic">@Model.MaKhachHangNavigation?.DiaChi</span></div>
                    <div>Số điện thoại: <span class="fw-bold">@Model.MaKhachHangNavigation?.SoDienThoai</span></div>
                    <div>Hình thức thanh toán: <span class="fw-bold">@Model.MaPtttNavigation?.TenPttt</span></div>
                </div>
                <div class="col-5 ps-4">
                    <div><i class="mdi mdi-map-marker me-1"></i> <span class="fw-bold">Địa chỉ:</span> 53/24 Nguyễn Thiện Thuật, Lộc Thọ, Nha Trang</div>
                    <div><i class="mdi mdi-phone me-1"></i> <span class="fw-bold">Số điện thoại:</span> 0347665000</div>
                    <div><i class="mdi mdi-web me-1"></i> <span class="fw-bold">Website:</span> http://www.ericshoes.vn</div>
                </div>
            </div>

            <table class="table table-bordered border-dark align-middle mb-0">
                <thead class="text-center fw-bold">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Tên sản phẩm</th>
                        <th style="width: 100px;">Số lượng</th>
                        <th style="width: 150px;">Đơn giá</th>
                        <th style="width: 180px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var ct in Model.ChiTietPhieuMuas)
                    {
                        <tr>
                            <td class="text-center">@(i++)</td>
                            <td class="ps-3">@ct.MaSanPhamNavigation?.TenSanPham</td>
                            <td class="text-center">@ct.SoLuong</td>
                            <td class="text-end pe-3">@string.Format("{0:N0}₫", ct.DonGia)</td>
                            <td class="text-end pe-3 fw-bold">@string.Format("{0:N0}₫", ct.DonGia * ct.SoLuong)</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="text-end fw-bold py-2 pe-3">Tổng tiền hàng:</td>
                        <td class="text-end pe-3 fw-bold">@string.Format("{0:N0}₫", Model.TongTien)</td>
                    </tr>
                    <tr>
                        <td colspan="4" class="text-end fw-bold py-2 pe-3" style="text-transform: uppercase;">Tổng cộng tiền thanh toán:</td>
                        <td class="text-end pe-3 fw-bold text-danger fs-5">@string.Format("{0:N0}₫", Model.TongTien)</td>
                    </tr>
                </tbody>
            </table>

            <div class="row mt-5 text-center">
                <div class="col-6">
                    <p class="fw-bold mb-1">Khách hàng</p>
                    <p class="small italic text-muted">(Ký, họ tên)</p>
                </div>
                <div class="col-6">
                    <p class="fw-bold mb-1">Nhân viên bán hàng</p>
                    <p class="small italic text-muted">(Ký, họ tên)</p>
                    <div class="mt-4 fw-bold text-primary">@Context.Session.GetString("Email")</div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 no-print">
            <button class="btn btn-gradient-primary-custom px-5 py-2 rounded-pill shadow" onclick="window.print()">
                <i class="mdi mdi-printer me-2"></i> IN HÓA ĐƠN NGAY
            </button>
        </div>
    }
    else if (!string.IsNullOrEmpty(Context.Request.Query["id"]))
    {
        <div class="text-center py-5">
            <i class="mdi mdi-file-search-outline text-muted" style="font-size: 5rem;"></i>
            <p class="text-muted mt-3">Không tìm thấy hóa đơn mã số: <b>@Context.Request.Query["id"]</b></p>
        </div>
    }
    else
    {
        <div class="text-center py-5 opacity-50">
            <i class="mdi mdi-file-document-outline" style="font-size: 5rem;"></i>
            <p class="mt-2">Vui lòng nhập mã số hóa đơn để hiển thị bản in</p>
        </div>
    }
</div>

@section styles {
    <style>
        .italic {
            font-style: italic;
        }

        /* Cấu hình in ấn */
        media print {
            /* Ẩn tất cả các phần tử không cần thiết khi in */
            .sidebar-wrapper, .navbar-custom, .no-print, .footer-custom, .page-header

        {
            display: none !important;
        }

        .main-panel-custom {
            margin: 0 !important;
            padding: 0 !important;
        }

        .content-wrapper-custom {
            padding: 0 !important;
        }

        .card {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }

        #invoice-print {
            border: none !important;
            box-shadow: none !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        body {
            background-color: #fff !important;
        }

        }

        /* Kẻ bảng đậm khi xem trên web */
        #invoice-print table th, #invoice-print table td {
            border: 1px solid #333 !important;
        }
    </style>
}