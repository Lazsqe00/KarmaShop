@model IEnumerable<KarmaShop.Models.SanPham>
@{
    Layout = "_ThuNganLayout";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-gradient-primary-custom text-white d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 45px; height: 45px; shadow: 0 4px 10px rgba(0,0,0,0.15)">
            <i class="mdi mdi-file-document-edit fs-4"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0 text-dark">Lập hóa đơn</h3>
            <small class="text-muted fw-bold">TN_BM1 — @DateTime.Now.ToString("'Ngày' dd 'Tháng' MM 'Năm' yyyy")</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3 text-primary"><i class="mdi mdi-account-card-details me-2"></i>THÔNG TIN KHÁCH HÀNG</h6>
                <div class="mb-3">
                    <label class="small fw-bold text-muted">Mã khách hàng:</label>
                    <input type="number" id="MaKH" class="form-control border-0 bg-light" placeholder="Nhập mã số KH...">
                </div>
                <div class="mb-0">
                    <label class="small fw-bold text-muted">Hình thức thanh toán:</label>
                    <select id="MaPttt" class="form-select border-0 bg-light">
                        @foreach (var p in ViewBag.PTTT)
                        {
                            <option value="@p.MaPttt">@p.TenPttt</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3 text-primary"><i class="mdi mdi-cart-plus me-2"></i>THÊM SẢN PHẨM</h6>
                <div class="mb-3">
                    <label class="small fw-bold text-muted">Chọn sản phẩm:</label>
                    <select id="MaSP" class="form-select border-0 bg-light py-2">
                        <option value="">-- Chọn sản phẩm --</option>
                        @foreach (var s in ViewBag.SanPhams)
                        {
                            <option value="@s.MaSanPham"
                                    data-price="@s.MaDongSanPhamNavigation?.GiaBan"
                                    data-name="@s.TenSanPham"
                                    data-type="@s.MaLoaiNavigation?.TenLoai"
                                    data-brand="@s.MaDongSanPhamNavigation?.MaThuongHieuNavigation?.TenThuongHieu"
                                    data-img="/images/@s.AnhDaiDien">
                                @s.TenSanPham
                            </option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="small fw-bold text-muted">Size:</label>
                        <input type="number" id="Size" class="form-control border-0 bg-light" placeholder="VD: 42">
                    </div>
                    <div class="col-6">
                        <label class="small fw-bold text-muted">Số lượng:</label>
                        <input type="number" id="Qty" class="form-control border-0 bg-light" value="1" min="1">
                    </div>
                </div>
                <button class="btn btn-gradient-primary-custom w-100 fw-bold py-2" onclick="addToOrder()">
                    <i class="mdi mdi-plus-box me-1"></i> THÊM VÀO GIỎ
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; overflow: hidden;">
            <div class="card-header bg-white py-3 border-bottom-0 text-center">
                <h5 class="fw-bold text-dark mb-0 mt-2">CHI TIẾT ĐƠN HÀNG</h5>
                <hr class="mx-auto w-25">
            </div>
            <div class="card-body p-0 d-flex flex-column">
                <div class="table-responsive flex-grow-1">
                    <table class="table align-middle mb-0" id="orderTable">
                        <thead class="bg-light text-dark small fw-bold">
                            <tr>
                                <th class="ps-3 text-center">STT</th>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center">Loại</th>
                                <th class="text-center">Thương hiệu</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="p-4 bg-light border-top mt-auto">
                    <div class="d-flex justify-content-end align-items-center mb-3">
                        <span class="fw-bold text-muted me-4">TỔNG CỘNG:</span>
                        <h3 class="fw-bold text-danger mb-0" id="totalDisplay">0₫</h3>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-secondary px-4 fw-bold" onclick="location.reload()">HỦY</button>
                        <button class="btn btn-gradient-success-custom px-5 fw-bold" onclick="saveOrder()">
                            <i class="mdi mdi-content-save me-1"></i> LƯU HÓA ĐƠN
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let orderItems = [];

    function addToOrder() {
        const sp = $("#MaSP option:selected");
        const size = $("#Size").val();
        const qty = parseInt($("#Qty").val());

        if (!sp.val()) return Swal.fire("Lỗi", "Vui lòng chọn sản phẩm!", "error");
        if (!size) return Swal.fire("Lỗi", "Vui lòng nhập Size!", "error");

        orderItems.push({
            MaSanPham: parseInt(sp.val()),
            TenSP: sp.data("name"),
            Loai: sp.data("type") || "N/A",
            Brand: sp.data("brand") || "N/A",
            Img: sp.data("img"),
            MaSize: parseInt(size),
            SoLuong: qty,
            GiaBan: parseFloat(sp.data("price"))
        });
        renderOrder();
    }

    function renderOrder() {
        let h = "";
        let total = 0;

        orderItems.forEach((it, i) => {
            let sum = it.SoLuong * it.GiaBan;
            total += sum;
            h += `
                <tr>
                    <td class="text-center text-muted">${i + 1}</td>
                    <td><img src="${it.Img}" width="40" height="40" class="rounded border" style="object-fit:cover" onerror="this.src='/images/default-shoe.png'"></td>
                    <td class="fw-bold">${it.TenSP} <br><small class="text-muted">Size: ${it.MaSize}</small></td>
                    <td class="text-center small">${it.Loai}</td>
                    <td class="text-center small">${it.Brand}</td>
                    <td class="text-end fw-semibold">${it.GiaBan.toLocaleString()}₫</td>
                    <td class="text-center">${it.SoLuong}</td>
                    <td class="text-end fw-bold text-danger">${sum.toLocaleString()}₫</td>
                    <td class="text-center">
                        <i class="mdi mdi-delete-forever text-danger fs-5" style="cursor:pointer" onclick="orderItems.splice(${i},1);renderOrder()"></i>
                    </td>
                </tr>`;
        });

        if(orderItems.length === 0) {
            h = '<tr><td colspan="9" class="text-center py-5 text-muted">Chưa có sản phẩm nào trong đơn hàng</td></tr>';
        }

        $("#orderTable tbody").html(h);
        $("#totalDisplay").text(total.toLocaleString() + "₫");
    }

    function saveOrder() {
        if (orderItems.length === 0) return Swal.fire("Chú ý", "Hóa đơn trống!", "warning");
        if (!$("#MaKH").val()) return Swal.fire("Chú ý", "Chưa nhập mã khách hàng!", "warning");

        const data = {
            MaKhachHang: parseInt($("#MaKH").val()),
            MaPttt: parseInt($("#MaPttt").val()),
            ChiTietPhieuMuas: orderItems
        };

        fetch('/NhanVien/ThuNgan/TaoHoaDon', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(r => r.json()).then(d => {
            if(d.success) {
                Swal.fire("Thành công", "Đã lưu hóa đơn!", "success").then(() => {
                    location.href='/NhanVien/ThuNgan/DanhSachHoaDon';
                });
            } else {
                Swal.fire("Lỗi", "Không thể lưu hóa đơn!", "error");
            }
        });
    }

    // Khởi tạo bảng trống lúc mới vào trang
    $(document).ready(function() {
        renderOrder();
    });
</script>

<style>
    .btn-gradient-success-custom {
        background: linear-gradient(to right, #84d9d2, #07cdae);
        border: none;
        color: white;
    }

        .btn-gradient-success-custom:hover {
            opacity: 0.9;
            color: white;
        }

    #orderTable thead th {
        border-top: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .table td {
        border-color: #f3f3f3;
    }
</style>