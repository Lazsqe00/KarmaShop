@model IEnumerable<KarmaShop.Models.SanPham>
@{
    Layout = "_ThuNganLayout";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
    <div class="card-body p-4 text-center">
        <h2 class="fw-bold text-dark mb-1 text-uppercase" style="letter-spacing: 1px;">Lập Hóa Đơn</h2>
        <p class="text-muted fw-bold mb-0">@DateTime.Now.ToString("'Ngày' dd 'Tháng' MM 'Năm' yyyy")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 text-center text-dark" style="letter-spacing: 0.5px;">THÔNG TIN KHÁCH HÀNG</h5>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Họ tên khách hàng:</label>
                        <select id="MaKhachHang" class="form-select border-0 bg-light py-2" onchange="updateCustomerInfo()">
                            <option value="">-- Chọn khách hàng từ hệ thống --</option>
                            @foreach (var k in ViewBag.KhachHangs)
                            {
                                <option value="@k.MaKhachHang" data-sdt="@k.SoDienThoai" data-diachi="@k.DiaChi">
                                    @k.TenKhachHang (@k.SoDienThoai)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Địa chỉ nhận hàng:</label>
                        <input type="text" id="DiaChiKH" class="form-control border-0 bg-light py-2" placeholder="Hệ thống tự điền..." readonly>
                    </div>

                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Số điện thoại:</label>
                        <input type="text" id="SdtKH" class="form-control border-0 bg-light py-2" placeholder="Hệ thống tự điền..." readonly>
                    </div>

                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Hình thức thanh toán:</label>
                        <select id="MaPttt" class="form-select border-0 bg-light py-2">
                            @foreach (var p in ViewBag.PTTT)
                            {
                                <option value="@p.MaPttt">@p.TenPttt</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-3 bg-light" style="border-radius: 12px;">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="small fw-bold text-dark mb-1"><i class="mdi mdi-plus-box text-primary me-1"></i>Chọn sản phẩm</label>
                        <select id="MaSP" class="form-select border-0 bg-white" onchange="updateSizeDropdown()">
                            <option value="">-- Chọn sản phẩm cần bán --</option>
                            @foreach (var s in (ViewBag.SanPhams as IEnumerable<KarmaShop.Models.SanPham>) ?? new List<KarmaShop.Models.SanPham>())
                            {
                                
                                var sizeListJson = s.SanPhamSizes != null
                                ? System.Text.Json.JsonSerializer.Serialize(s.SanPhamSizes.Select(sz => new { id = sz.MaSize, name = sz.MaSizeNavigation?.TenSize }).Where(x => x.name != null))
                                : "[]";

                                <option value="@s.MaSanPham"
                                        data-price="@s.MaDongSanPhamNavigation?.GiaBan"
                                        data-name="@s.TenSanPham"
                                        data-dongsp="@(s.MaDongSanPhamNavigation?.TenDongSanPham ?? "Chưa rõ")"
                                        data-mau="@(s.MaMauNavigation?.TenMau ?? "Chưa rõ")"
                                        data-img="/img/@s.MaDongSanPham/Avatar/@s.AnhDaiDien"
                                        data-sizes="@sizeListJson">
                                    @s.TenSanPham - @string.Format("{0:N0}₫", s.MaDongSanPhamNavigation?.GiaBan)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-dark mb-1">Size</label>
                        <select id="Size" class="form-select border-0 bg-white">
                            <option value="">-- Chọn Size --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-dark mb-1">Số lượng</label>
                        <input type="number" id="Qty" class="form-control border-0 bg-white" value="1" min="1">
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100 fw-bold" onclick="addToOrder()">
                            <i class="mdi mdi-cart-plus me-1"></i> Thêm vào bảng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm mb-5" style="border-radius: 12px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="orderTable">
                    <thead class="bg-light text-dark small fw-bold text-center">
                        <tr>
                            <th style="width: 5%">STT</th>
                            <th style="width: 10%">Ảnh sản phẩm</th>
                            <th style="width: 25%">Tên sản phẩm</th>
                            <th style="width: 15%">Đồng sản phẩm</th>
                            <th style="width: 10%">Màu sắc</th>
                            <th style="width: 8%">Size</th>
                            <th style="width: 10%">Đơn giá</th>
                            <th style="width: 7%">Số lượng</th>
                            <th style="width: 10%">Thành tiền</th>
                            <th style="width: 5%">Xóa</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr class="bg-light">
                            <td colspan="8" class="text-end fw-bold text-dark py-3 fs-5">Tổng tiền hàng:</td>
                            <td colspan="2" class="text-end fw-bold text-danger py-3 fs-5 pe-4" id="lblTongTienHang">0₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="card-footer bg-white p-4 border-top d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary px-4 fw-bold" onclick="location.reload()">HỦY ĐƠN</button>
                <button class="btn btn-gradient-success-custom px-5 fw-bold" onclick="saveOrder()">
                    <i class="mdi mdi-content-save me-1"></i> TẠO HÓA ĐƠN
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let orderItems = [];

    function updateSizeDropdown() {
        const selectedOpt = $("#MaSP option:selected");
        const sizeDropdown = $("#Size");

        sizeDropdown.html('<option value="">-- Chọn Size --</option>');

        if (selectedOpt.val() !== "") {
            const sizes = selectedOpt.data("sizes");
            if (sizes && sizes.length > 0) {
                sizes.forEach(sz => {
                    sizeDropdown.append(`<option value="${sz.id}">${sz.name}</option>`);
                });
            } else {
                sizeDropdown.html('<option value="">-- Hết size --</option>');
            }
        }
    }

    function updateCustomerInfo() {
        const selectedOpt = $("#MaKhachHang option:selected");
        if (selectedOpt.val() !== "") {
            $("#SdtKH").val(selectedOpt.data("sdt") || "Chưa có");
            $("#DiaChiKH").val(selectedOpt.data("diachi") || "Chưa có");
        } else {
            $("#SdtKH").val("");
            $("#DiaChiKH").val("");
        }
    }

    function addToOrder() {
        const sp = $("#MaSP option:selected");
        const sizeOpt = $("#Size option:selected");
        const qty = parseInt($("#Qty").val());

        if (!sp.val()) return Swal.fire("Chú ý", "Vui lòng chọn sản phẩm!", "warning");
        if (!sizeOpt.val()) return Swal.fire("Chú ý", "Vui lòng chọn Size!", "warning");
        if (isNaN(qty) || qty <= 0) return Swal.fire("Chú ý", "Số lượng bán ra phải từ 1 trở lên!", "warning");

        
        const existing = orderItems.find(x => x.MaSanPham == sp.val() && x.MaSize == sizeOpt.val());
        if (existing) {
            existing.SoLuong += qty;
        } else {
            orderItems.push({
                MaSanPham: parseInt(sp.val()),
                TenSP: sp.data("name"),
                DongSP: sp.data("dongsp"),
                MauSac: sp.data("mau"),
                Img: sp.data("img"),
                MaSize: parseInt(sizeOpt.val()),
                TenSize: sizeOpt.text(),         
                SoLuong: qty,
                GiaBan: parseFloat(sp.data("price")) || 0
            });
        }
        renderOrder();
    }

    function renderOrder() {
        let h = "";
        let tongTienHang = 0;

        orderItems.forEach((it, i) => {
            let sum = it.SoLuong * it.GiaBan;
            tongTienHang += sum;
            h += `
                <tr>
                    <td class="text-center fw-bold">${i + 1}</td>
                    <td class="text-center"><img src="${it.Img}" width="45" height="45" class="rounded shadow-sm" style="object-fit:cover" onerror="this.src='/images/default-shoe.png'"></td>
                    <td class="fw-bold text-dark">${it.TenSP}</td>
                    <td class="text-center text-muted small">${it.DongSP}</td>
                    <td class="text-center text-muted small">${it.MauSac}</td>
                    <td class="text-center fw-bold text-secondary">${it.TenSize}</td>
                    <td class="text-end fw-semibold">${it.GiaBan.toLocaleString()}₫</td>
                    <td class="text-center fw-bold">${it.SoLuong}</td>
                    <td class="text-end fw-bold text-dark">${sum.toLocaleString()}₫</td>
                    <td class="text-center">
                        <i class="mdi mdi-delete-forever text-danger fs-4" style="cursor:pointer" onclick="orderItems.splice(${i},1);renderOrder()"></i>
                    </td>
                </tr>`;
        });

        if(orderItems.length === 0) {
            h = '<tr><td colspan="10" class="text-center py-5 text-muted fst-italic">Danh sách trống - Hãy thêm sản phẩm ở thanh điều hướng trên</td></tr>';
        }

        $("#orderTable tbody").html(h);
        $("#lblTongTienHang").text(tongTienHang.toLocaleString() + "₫");
    }

    function saveOrder() {
        const maKH = $("#MaKhachHang").val();
        if (!maKH) return Swal.fire("Chú ý", "Vui lòng chọn một khách hàng từ hệ thống!", "warning");
        if (orderItems.length === 0) return Swal.fire("Chú ý", "Hóa đơn trống, vui lòng thêm sản phẩm!", "warning");

        const data = {
            MaKhachHang: parseInt(maKH),
            MaPttt: parseInt($("#MaPttt").val()),
            ChiTietPhieuMuas: orderItems.map(item => ({
                MaSanPham: item.MaSanPham,
                MaSize: item.MaSize,
                SoLuong: item.SoLuong,
                GiaBan: item.GiaBan
            }))
        };

        fetch('/NhanVien/ThuNgan/TaoHoaDon', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(d => {
            if(d.success) {
                Swal.fire("Thành công", "Đã lưu thông tin hóa đơn tạm tính!", "success").then(() => {
                    location.href = '/NhanVien/ThuNgan/DanhSachHoaDon';
                });
            } else {
                Swal.fire("Lỗi kho", d.msg || "Không thể thực hiện lưu hóa đơn!", "error");
            }
        });
    }

    $(document).ready(function() {
        renderOrder();
    });
</script>

<style>
    .bg-gradient-primary-custom {
        background: linear-gradient(135deg, #6e8efb, #a777e3);
    }

    .btn-gradient-success-custom {
        background: linear-gradient(to right, #00b09b, #96c93d);
        border: none;
        color: white;
    }

        .btn-gradient-success-custom:hover {
            opacity: 0.9;
            color: white;
            transform: translateY(-1px);
        }

    #orderTable {
        border: 1px solid #dee2e6;
    }

        #orderTable thead th {
            vertical-align: middle;
            background-color: #f4f6f9;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
        }

        #orderTable td {
            font-size: 13.5px;
        }
</style>