@model IEnumerable<KarmaShop.Models.SanPham>
@{
    Layout = "_ThuNganLayout";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
    <div class="card-body p-4 text-center">
        <h2 class="fw-bold text-dark mb-1 text-uppercase" style="letter-spacing: 1px;">Lập Hóa Đơn</h2>
        <p class="text-muted fw-bold mb-0">@DateTime.Now.ToString("'Ngày' dd 'Tháng' MM 'Năm' yyyy")</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 text-center text-dark" style="letter-spacing: 0.5px;">THÔNG TIN KHÁCH HÀNG</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Họ tên khách hàng:</label>
                        <select id="MaKhachHang" class="form-select border-0 bg-light py-2" onchange="updateCustomerInfo()">
                            <option value="">-- Chọn khách hàng từ hệ thống --</option>
                            @foreach (var k in ViewBag.KhachHangs)
                            {
                                <option value="@k.MaKhachHang" data-sdt="@k.SoDienThoai" data-diachi="@k.DiaChi">
                                    @k.TenKhachHang (@k.SoDienThoai)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Địa chỉ nhận hàng:</label>
                        <input type="text" id="DiaChiKH" class="form-control border-0 bg-light py-2" placeholder="Hệ thống tự điền..." readonly>
                    </div>
                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Số điện thoại:</label>
                        <input type="text" id="SdtKH" class="form-control border-0 bg-light py-2" placeholder="Hệ thống tự điền..." readonly>
                    </div>
                    <div class="col-12">
                        <label class="small fw-bold text-secondary mb-1">Hình thức thanh toán:</label>
                        <select id="MaPttt" class="form-select border-0 bg-light py-2">
                            @foreach (var p in ViewBag.PTTT)
                            {
                                <option value="@p.MaPttt">@p.TenPttt</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-3 bg-light" style="border-radius: 12px;">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="small fw-bold text-dark mb-1"><i class="mdi mdi-plus-box text-primary me-1"></i>Chọn sản phẩm</label>
                        <select id="MaSP" class="form-select border-0 bg-white" onchange="updateSizeDropdown()">
                            <option value="">-- Chọn sản phẩm cần bán --</option>
                            @foreach (var s in (ViewBag.SanPhams as IEnumerable<KarmaShop.Models.SanPham>) ?? new List<KarmaShop.Models.SanPham>())
                            {
                                var sizeListJson = s.SanPhamSizes != null
                                ? System.Text.Json.JsonSerializer.Serialize(s.SanPhamSizes.Select(sz => new { id = sz.MaSize, name = sz.MaSizeNavigation?.TenSize }).Where(x => x.name != null))
                                : "[]";
                                <option value="@s.MaSanPham"
                                        data-price="@s.MaDongSanPhamNavigation?.GiaBan"
                                        data-name="@s.TenSanPham"
                                        data-dongsp="@(s.MaDongSanPhamNavigation?.TenDongSanPham ?? "Chưa rõ")"
                                        data-mau="@(s.MaMauNavigation?.TenMau ?? "Chưa rõ")"
                                        data-img="/img/@s.MaDongSanPham/Avatar/@s.AnhDaiDien"
                                        data-sizes="@sizeListJson">
                                    @s.TenSanPham - @string.Format("{0:N0}₫", s.MaDongSanPhamNavigation?.GiaBan)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-dark mb-1">Size</label>
                        <select id="Size" class="form-select border-0 bg-white">
                            <option value="">-- Chọn Size --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="small fw-bold text-dark mb-1">Số lượng</label>
                        <input type="number" id="Qty" class="form-control border-0 bg-white" value="1" min="1">
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100 fw-bold" onclick="addToOrder()">
                            <i class="mdi mdi-cart-plus me-1"></i> Thêm vào bảng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-0 shadow-sm mb-5" style="border-radius: 12px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0" id="orderTable">
                    <thead class="bg-light text-dark small fw-bold text-center">
                        <tr>
                            <th style="width: 5%">STT</th>
                            <th style="width: 10%">Ảnh sản phẩm</th>
                            <th style="width: 30%">Tên sản phẩm</th>
                            <th style="width: 12%">Màu sắc</th>
                            <th style="width: 8%">Size</th>
                            <th style="width: 12%">Đơn giá</th>
                            <th style="width: 8%">Số lượng</th>
                            <th style="width: 10%">Thành tiền</th>
                            <th style="width: 5%">Xóa</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr class="bg-light">
                            <td colspan="7" class="text-end fw-bold text-dark py-3 fs-5">Tổng tiền hàng:</td>
                            <td colspan="2" class="text-end fw-bold text-danger py-3 fs-5 pe-4" id="lblTongTienHang">0₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="card-footer bg-white p-4 border-top d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary px-4 fw-bold" onclick="location.reload()">HỦY ĐƠN</button>
                <button class="btn btn-gradient-success-custom px-5 fw-bold" onclick="saveOrder()">
                    <i class="mdi mdi-content-save me-1"></i> TẠO HÓA ĐƠN
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let orderItems = [];

        function themVaoHoaDonTaiQuay(maSanPham, maSize) {
            var targetOption = document.querySelector('#MaSP option[value="' + maSanPham + '"]');
            if (!targetOption) {
                alert("Không tìm thấy sản phẩm mã " + maSanPham + " trong danh sách!");
                return;
            }
            var tenSp  = targetOption.getAttribute("data-name");
            var price  = parseFloat(targetOption.getAttribute("data-price")) || 0;
            var mauSac = targetOption.getAttribute("data-mau");
            var img    = targetOption.getAttribute("data-img");
            var sizesRaw = targetOption.getAttribute("data-sizes");
            var sizes  = [];
            try { sizes = JSON.parse(sizesRaw); } catch(e) {}

            var targetSize = sizes.find(function(s) { return s.id == maSize; });
            var tenSize = targetSize ? targetSize.name : maSize.toString();

            var existing = orderItems.find(function(x) { return x.MaSanPham === maSanPham && x.MaSize === maSize; });
            if (existing) {
                existing.SoLuong += 1;
            } else {
                orderItems.push({
                    MaSanPham: maSanPham,
                    TenSP:     tenSp,
                    MauSac:    mauSac,
                    Img:       img,
                    MaSize:    maSize,
                    TenSize:   tenSize,
                    SoLuong:   1,
                    GiaBan:    price
                });
            }
            renderOrder();
        }
        window.themVaoHoaDonTaiQuay = themVaoHoaDonTaiQuay;

        function updateSizeDropdown() {
            var sel = document.getElementById("MaSP");
            var opt = sel.options[sel.selectedIndex];
            var sizeDropdown = document.getElementById("Size");
            sizeDropdown.innerHTML = '<option value="">-- Chọn Size --</option>';
            if (opt && opt.value !== "") {
                var sizes = [];
                try { sizes = JSON.parse(opt.getAttribute("data-sizes")); } catch(e) {}
                if (sizes && sizes.length > 0) {
                    sizes.forEach(function(sz) {
                        sizeDropdown.innerHTML += '<option value="' + sz.id + '">' + sz.name + '</option>';
                    });
                } else {
                    sizeDropdown.innerHTML = '<option value="">-- Hết size --</option>';
                }
            }
        }

        function updateCustomerInfo() {
            var sel = document.getElementById("MaKhachHang");
            var opt = sel.options[sel.selectedIndex];
            if (opt && opt.value !== "") {
                document.getElementById("SdtKH").value   = opt.getAttribute("data-sdt") || "Chưa có";
                document.getElementById("DiaChiKH").value = opt.getAttribute("data-diachi") || "Chưa có";
            } else {
                document.getElementById("SdtKH").value   = "";
                document.getElementById("DiaChiKH").value = "";
            }
        }

        function addToOrder() {
            var selSP   = document.getElementById("MaSP");
            var selSize = document.getElementById("Size");
            var qty     = parseInt(document.getElementById("Qty").value);
            var spOpt   = selSP.options[selSP.selectedIndex];
            var sizeOpt = selSize.options[selSize.selectedIndex];

            if (!spOpt || !spOpt.value)   { Swal.fire("Chú ý", "Vui lòng chọn sản phẩm!", "warning"); return; }
            if (!sizeOpt || !sizeOpt.value){ Swal.fire("Chú ý", "Vui lòng chọn Size!", "warning"); return; }
            if (isNaN(qty) || qty <= 0)    { Swal.fire("Chú ý", "Số lượng phải từ 1 trở lên!", "warning"); return; }

            var maSP   = parseInt(spOpt.value);
            var maSize = parseInt(sizeOpt.value);
            var existing = orderItems.find(function(x) { return x.MaSanPham === maSP && x.MaSize === maSize; });
            if (existing) {
                existing.SoLuong += qty;
            } else {
                var sizes = [];
                try { sizes = JSON.parse(spOpt.getAttribute("data-sizes")); } catch(e) {}
                orderItems.push({
                    MaSanPham: maSP,
                    TenSP:     spOpt.getAttribute("data-name"),
                    MauSac:    spOpt.getAttribute("data-mau"),
                    Img:       spOpt.getAttribute("data-img"),
                    MaSize:    maSize,
                    TenSize:   sizeOpt.text,
                    SoLuong:   qty,
                    GiaBan:    parseFloat(spOpt.getAttribute("data-price")) || 0
                });
            }
            renderOrder();
        }

        function renderOrder() {
            var h = "";
            var tongTienHang = 0;
            orderItems.forEach(function(it, i) {
                var sum = it.SoLuong * it.GiaBan;
                tongTienHang += sum;
                h += '<tr>' +
                    '<td class="text-center fw-bold">' + (i+1) + '</td>' +
                    '<td class="text-center"><img src="' + it.Img + '" width="45" height="45" class="rounded shadow-sm" style="object-fit:cover" onerror="this.src=\'/images/default-shoe.png\'"></td>' +
                    '<td class="fw-bold text-dark">' + it.TenSP + '</td>' +
                    '<td class="text-center text-muted small">' + it.MauSac + '</td>' +
                    '<td class="text-center fw-bold text-secondary">' + it.TenSize + '</td>' +
                    '<td class="text-end fw-semibold">' + it.GiaBan.toLocaleString() + '₫</td>' +
                    '<td class="text-center"><div class="d-flex align-items-center justify-content-center gap-1">' +
                        '<button class="btn btn-xs btn-light border py-0 px-2" onclick="chinhSoLuongTruocTiep(' + i + ', -1)">-</button>' +
                        '<span class="fw-bold px-1">' + it.SoLuong + '</span>' +
                        '<button class="btn btn-xs btn-light border py-0 px-2" onclick="chinhSoLuongTruocTiep(' + i + ', 1)">+</button>' +
                    '</div></td>' +
                    '<td class="text-end fw-bold text-dark">' + sum.toLocaleString() + '₫</td>' +
                    '<td class="text-center"><i class="mdi mdi-delete-forever text-danger fs-4" style="cursor:pointer" onclick="orderItems.splice(' + i + ',1);renderOrder()"></i></td>' +
                    '</tr>';
            });
            if (orderItems.length === 0) {
                h = '<tr><td colspan="9" class="text-center py-5 text-muted fst-italic">Danh sách trống - Hãy thêm sản phẩm ở thanh điều hướng trên hoặc từ bảng tra cứu</td></tr>';
            }
            document.querySelector("#orderTable tbody").innerHTML = h;
            document.getElementById("lblTongTienHang").textContent = tongTienHang.toLocaleString() + "₫";
        }

        function chinhSoLuongTruocTiep(index, thayDoi) {
            if (orderItems[index]) {
                orderItems[index].SoLuong += thayDoi;
                if (orderItems[index].SoLuong <= 0) orderItems.splice(index, 1);
                renderOrder();
            }
        }

        function saveOrder() {
            var maKH = document.getElementById("MaKhachHang").value;
            if (!maKH)                   { Swal.fire("Chú ý", "Vui lòng chọn một khách hàng!", "warning"); return; }
            if (orderItems.length === 0) { Swal.fire("Chú ý", "Hóa đơn trống, vui lòng thêm sản phẩm!", "warning"); return; }

            var data = {
                MaKhachHang: parseInt(maKH),
                MaPttt: parseInt(document.getElementById("MaPttt").value),
                ChiTietPhieuMuas: orderItems.map(function(item) {
                    return { MaSanPham: item.MaSanPham, MaSize: item.MaSize, SoLuong: item.SoLuong, DonGia: item.GiaBan };
                })
            };
            fetch('/NhanVien/ThuNgan/TaoHoaDon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.success) {
                    Swal.fire("Thành công", "Đã lưu hóa đơn và trừ kho thành công!", "success")
                        .then(function() { location.href = '/NhanVien/ThuNgan/DanhSachHoaDon'; });
                } else {
                    Swal.fire("Lỗi", d.msg || "Không thể lưu hóa đơn!", "error");
                }
            });
        }

        // Đọc sản phẩm pending từ localStorage sau khi jQuery và trang đã load xong
        $(document).ready(function() {
            renderOrder();
            var pending = localStorage.getItem("pendingOrderItems");
            if (pending) {
                localStorage.removeItem("pendingOrderItems");
                var pendingItems = JSON.parse(pending);
                pendingItems.forEach(function(item) {
                    themVaoHoaDonTaiQuay(item.MaSanPham, item.MaSize);
                });
            }
        });
    </script>
}

<style>
    .bg-gradient-primary-custom {
        background: linear-gradient(135deg, #6e8efb, #a777e3);
    }

    .btn-gradient-success-custom {
        background: linear-gradient(to right, #00b09b, #96c93d);
        border: none;
        color: white;
    }

        .btn-gradient-success-custom:hover {
            opacity: 0.9;
            color: white;
            transform: translateY(-1px);
        }

    #orderTable {
        border: 1px solid #dee2e6;
    }

        #orderTable thead th {
            vertical-align: middle;
            background-color: #f4f6f9;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
        }

        #orderTable td {
            font-size: 13.5px;
        }
</style>