@model KarmaShop.Models.SanPham

<div class="modal-header border-0 pb-0">
    <div class="d-flex align-items-center">
        <div class="bg-gradient-primary-custom text-white d-flex align-items-center justify-content-center rounded-circle me-2" style="width: 32px; height: 32px; background: linear-gradient(to right, #4e73df, #224abe);">
            <i class="mdi mdi-information-outline fs-5 text-white"></i>
        </div>
        <h5 class="fw-bold mb-0 text-dark">Thông tin sản phẩm quầy</h5>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <div class="text-center mb-4 bg-light rounded-4 p-3 shadow-sm" style="background-color: #f8f9fa !important; border: 1px solid #eee;">
        <img src="/img/@Model.MaDongSanPham/Avatar/@Model.AnhDaiDien"
             style="max-height: 220px; width: 100%; object-fit: contain;"
             class="img-fluid"
             onerror="this.src='/images/default-shoe.png'">
    </div>

    <div class="text-center mb-4">
        <h4 class="fw-bold text-dark mb-1">@Model.TenSanPham</h4>
        <span class="badge bg-soft-primary text-primary px-3 py-2" style="background-color: #eef2ff;">
            <i class="mdi mdi-tag-outline me-1"></i>@($"SP{Model.MaSanPham:D2}")
        </span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6">
            <div class="p-3 border rounded-3 bg-white text-center">
                <small class="text-muted d-block mb-1 fw-bold">GIÁ BÁN</small>
                <h5 class="text-danger fw-bold mb-0">@string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:#,##0} ₫", Model.MaDongSanPhamNavigation?.GiaBan ?? 0)</h5>
            </div>
        </div>

        <div class="col-6">
            <div class="p-3 border rounded-3 bg-white text-center">
                <small class="text-muted d-block mb-1 fw-bold">PHÂN LOẠI</small>
                <h6 class="text-dark fw-bold mb-0">
                    @(Model.MaDongSanPhamNavigation?.MaLoaiNavigation?.TenLoai ?? "Đang cập nhật")
                </h6>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div id="slton-modal" class="p-2 rounded text-center" style="display:none; background-color: #fff9db; border: 1px solid #ffe066;">
            <h6 style="color:#BA861E;" class="fw-bold mb-0">
                <i class="mdi mdi-clock-alert-outline fs-5 me-1"></i> Kho tại quầy còn ít hàng!
            </h6>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-12">
            <span class="text-muted fw-semibold d-block mb-1"><i class="mdi mdi-format-size me-1"></i>Chọn Size khách mua:</span>
        </div>

        @{
            var danhSachSize = Model.SanPhamSizes?.ToList() ?? new List<KarmaShop.Models.SanPhamSize>();
            var mangSoLuongTon = danhSachSize.Select(sz => sz.SoLuong ?? 0).ToList();
        }

        @if (danhSachSize.Any())
        {
            for (int i = 0; i < danhSachSize.Count; i++)
            {
                var item = danhSachSize[i];
                bool coHang = (item.SoLuong ?? 0) > 0;
                string boxClass = coHang ? "box-kho-modal" : "box-kho-modal kho-disable-modal";
                string onclickAttr = coHang ? $"updateModalSizeIndex(this, {i}, {item.MaSize})" : "";
                string tenHiểnThiSize = item.MaSizeNavigation?.TenSize ?? item.MaSize.ToString();

                <div class="col-3">
                    <div class="@boxClass" onclick="@onclickAttr">
                        @tenHiểnThiSize
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <small class="text-danger">Sản phẩm này trong kho tạm thời hết size.</small>
            </div>
        }

        <div class="col-12 mt-1">
            <small id="sizeError-modal" class="text-danger fw-bold" style="visibility:hidden;"><i class="mdi mdi-alert-circle-outline me-1"></i>Vui lòng chọn size giày!</small>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12">
            <div class="p-3 border rounded-3 bg-white">

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-palette-outline text-muted fs-4 me-2"></i>
                        <span class="text-muted fw-semibold">Màu sắc</span>
                    </div>
                    <span class="fw-bold text-dark">@(Model.MaMauNavigation?.TenMau ?? "Mặc định")</span>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal-footer border-0 pt-0 d-flex flex-column gap-2">
    <button type="button" id="AddToCart-Modal" class="btn btn-add-cart-custom w-100 py-2.5 fw-bold text-uppercase shadow" onclick="XacNhanThemTuModal(event)">
        <i class="mdi mdi-cart-plus me-1"></i> Thêm vào hóa đơn
    </button>
    <button type="button" class="btn btn-light fw-bold w-100 py-2 border text-secondary" data-bs-dismiss="modal" style="border-radius: 8px;">ĐÓNG</button>
</div>

<script>
    (function () {
        var elements = document.getElementsByClassName("box-kho-modal");
        for (var i = 0; i < elements.length; ++i) {
            elements[i].classList.remove("active");
        }
        var addToCartBtn = document.getElementById("AddToCart-Modal");
        if (addToCartBtn) {
            addToCartBtn.removeAttribute("data-masize");
        }
        var sltonDiv = document.getElementById("slton-modal");
        if (sltonDiv) sltonDiv.style.display = "none";

        var sizeErr = document.getElementById("sizeError-modal");
        if (sizeErr) sizeErr.style.visibility = "hidden";
    })();

    function updateModalSizeIndex(element, index, maSize) {
        document.getElementById("sizeError-modal").style.visibility = "hidden";

        var arrayTontai = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mangSoLuongTon));
        var sltonDiv = document.getElementById("slton-modal");

        if (arrayTontai[index] < 10 && arrayTontai[index] > 0) {
            sltonDiv.style.display = "block";
        } else {
            sltonDiv.style.display = "none";
        }

        var elements = document.getElementsByClassName("box-kho-modal");
        for (var i = 0; i < elements.length; ++i) {
            elements[i].classList.remove("active");
        }
        element.classList.add("active");

        var addToCartBtn = document.getElementById("AddToCart-Modal");
        if (addToCartBtn) {
            addToCartBtn.setAttribute("data-masize", maSize);
        }
    }

        function XacNhanThemTuModal(event) {
        event.preventDefault();

        var link = document.getElementById("AddToCart-Modal");
        var maSize = link.getAttribute("data-masize");
        if (!maSize || maSize === "null" || maSize === "") {
            document.getElementById("sizeError-modal").style.visibility = "visible";
            return;
        }

        var productId = @Model.MaSanPham;


        var pendingItems = JSON.parse(localStorage.getItem("pendingOrderItems") || "[]");
        var existing = pendingItems.find(function(x) {
            return x.MaSanPham === productId && x.MaSize === parseInt(maSize);
        });
        if (existing) {
            existing.SoLuong += 1;
        } else {
            pendingItems.push({
                MaSanPham: productId,
                MaSize: parseInt(maSize)
            });
        }
        localStorage.setItem("pendingOrderItems", JSON.stringify(pendingItems));


        window.location.href = '/NhanVien/ThuNgan/LapHoaDon';
    }
</script>

<style>
    .box-kho-modal {
        border: 2px solid #dee2e6;
        border-radius: 6px;
        padding: 8px 6px;
        cursor: pointer;
        color: #212529;
        font-weight: 600;
        font-size: 14px;
        text-align: center;
        transition: all 0.2s ease-in-out;
    }

        .box-kho-modal:hover {
            border-color: #4e73df;
            color: #4e73df;
        }

        .box-kho-modal.active {
            border-color: #224abe;
            background-color: #eef2ff;
            color: #224abe;
        }

    .kho-disable-modal {
        opacity: 0.4;
        pointer-events: none;
        background-color: #e9ecef;
        border-color: #dee2e6;
        text-decoration: line-through;
    }

    .btn-add-cart-custom {
        background: linear-gradient(to right, #4e73df, #224abe);
        border: none;
        border-radius: 8px;
        color: white !important;
        transition: all 0.2s ease;
    }

        .btn-add-cart-custom:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(34, 74, 190, 0.3) !important;
        }
</style>
