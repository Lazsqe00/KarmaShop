@model KarmaShop.Models.SanPham

<div class="modal-header border-0 pb-0">
    <div class="d-flex align-items-center">
        <div class="bg-gradient-primary-custom text-white d-flex align-items-center justify-content-center rounded-circle me-2" style="width: 32px; height: 32px; background: linear-gradient(to right, #4e73df, #224abe);">
            <i class="mdi mdi-information-outline fs-5 text-white"></i>
        </div>
        <h5 class="fw-bold mb-0 text-dark">Thông tin sản phẩm</h5>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <div class="text-center mb-4 bg-light rounded-4 p-3 shadow-sm" style="background-color: #f8f9fa !important; border: 1px solid #eee;">
        <img src="/images/@Model.AnhDaiDien"
             style="max-height: 220px; width: 100%; object-fit: contain;"
             class="img-fluid"
             onerror="this.src='/images/default-shoe.png'">
    </div>

    <div class="text-center mb-4">
        <h4 class="fw-bold text-dark mb-1">@Model.TenSanPham</h4>
        <span class="badge bg-soft-primary text-primary px-3 py-2" style="background-color: #eef2ff;">
            <i class="mdi mdi-tag-outline me-1"></i>@($"SP{Model.MaSanPham:D2}")
        </span>
    </div>

    <div class="row g-3">
        <div class="col-6">
            <div class="p-3 border rounded-3 bg-white text-center">
                <small class="text-muted d-block mb-1 fw-bold">GIÁ BÁN</small>
                <h5 class="text-danger fw-bold mb-0">@string.Format("{0:N0}₫", Model.MaDongSanPhamNavigation?.GiaBan ?? 0)</h5>
            </div>
        </div>

        <div class="col-6">
            <div class="p-3 border rounded-3 bg-white text-center">
                <small class="text-muted d-block mb-1 fw-bold">PHÂN LOẠI</small>
                <h6 class="text-dark fw-bold mb-0">
                    
                    @(Model.MaDongSanPhamNavigation?.MaLoaiNavigation?.TenLoai ?? "Đang cập nhật")
                </h6>
            </div>
        </div>

        <div class="col-12">
            <div class="p-3 border rounded-3 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-factory text-muted fs-4 me-2"></i>
                        <span class="text-muted fw-semibold">Thương hiệu</span>
                    </div>
                    
                    <span class="fw-bold text-dark">Eric Shoes Nha Trang</span>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <div class="d-flex align-items-center">
                        <i class="mdi mdi-palette-outline text-muted fs-4 me-2"></i>
                        <span class="text-muted fw-semibold">Màu sắc</span>
                    </div>
                    <span class="fw-bold text-dark">@(Model.MaMauNavigation?.TenMau ?? "Mặc định")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer border-0 pt-0">
    <button type="button" class="btn btn-light fw-bold w-100 py-2 shadow-sm" data-bs-dismiss="modal" style="border-radius: 8px;">ĐÓNG</button>
</div>

<style>
    .bg-soft-primary {
        background-color: #eef2ff;
        color: #4e73df;
    }

    .modal-content {
        border-radius: 15px;
        border: none;
    }
</style>