@model IEnumerable<KarmaShop.Models.Loai>
@{ ViewBag.Title = "Loại giày"; }
<h1 class="text-center fw-bold mt-5 mb-4">DANH SÁCH LOẠI GIÀY</h1>
<p><a asp-area="Admin" asp-controller="Loai" asp-action="Create" class="btn btn-success">+ Thêm mới</a></p>
<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr><th>STT</th><th>Tên loại</th><th>Hành động</th></tr>
        </thead>
        <tbody>
            @{ int stt = (ViewBag.CurrentPage - 1) * 10 + 1; }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@stt</td>
                    <td>@item.TenLoai</td>
                    <td class="text-center">
                        <a asp-area="Admin" asp-controller="Loai" asp-action="Details" asp-route-id="@item.MaLoai" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-area="Admin" asp-controller="Loai" asp-action="Edit" asp-route-id="@item.MaLoai" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-area="Admin" asp-controller="Loai" asp-action="Delete" asp-route-id="@item.MaLoai"
                           onclick="return confirm('Xóa loại này?');" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>

@{
    int cur = ViewBag.CurrentPage;
    int tot = ViewBag.TotalPages;
}
@if (tot > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(cur == 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Loai" asp-action="Index" asp-route-page="@(cur - 1)">«</a>
            </li>
            @for (int p = Math.Max(1, cur - 2); p <= Math.Min(tot, cur + 2); p++)
            {
                <li class="page-item @(p == cur ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Loai" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(cur == tot ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Loai" asp-action="Index" asp-route-page="@(cur + 1)">»</a>
            </li>
        </ul>
    </nav>
}
