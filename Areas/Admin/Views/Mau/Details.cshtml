@model KarmaShop.Models.Mau
@{
    ViewBag.Title = "Chi tiết màu sắc";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-info-circle me-2"></i>CHI TIẾT MÀU SẮC</h3>
    <div>
        <a asp-area="Admin" asp-controller="Mau" asp-action="Edit"
           asp-route-id="@Model.MaMau" class="btn btn-warning me-2">
            <i class="fas fa-edit me-1"></i> Sửa
        </a>
        <a asp-area="Admin" asp-controller="Mau" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-body">
        <table class="table table-borderless">
            <tr>
                <td class="fw-bold" style="width:40%">Mã màu:</td>
                <td><code>@Model.MaMau</code></td>
            </tr>
            <tr>
                <td class="fw-bold">Tên màu:</td>
                <td>@Model.TenMau</td>
            </tr>
        </table>
    </div>
</div>
