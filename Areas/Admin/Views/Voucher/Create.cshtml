@model KarmaShop.Models.Voucher
@{
    ViewBag.Title = "Tạo voucher mới";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-plus-circle me-2"></i>TẠO VOUCHER MỚI</h3>
    <a asp-area="Admin" asp-controller="Voucher" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Thông tin voucher</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Voucher" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="MaVoucher" class="form-label fw-bold">Mã Voucher <span class="text-danger">*</span></label>
                <input asp-for="MaVoucher" class="form-control text-uppercase" required
                       placeholder="VD: SALE10, FREESHIP..." maxlength="20" />
                <span asp-validation-for="MaVoucher" class="text-danger"></span>
                <small class="text-muted">Mã tối đa 20 ký tự</small>
            </div>

            <div class="mb-3">
                <label asp-for="SoLuong" class="form-label fw-bold">Số lượng <span class="text-danger">*</span></label>
                <input asp-for="SoLuong" type="number" class="form-control" required min="1" placeholder="Nhập số lượng" />
                <span asp-validation-for="SoLuong" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Loại giảm giá</label>
                <select asp-for="LoaiGiamGia" class="form-select">
                    <option value="Phần trăm">Phần trăm</option>
                    <option value="Tiền mặt">Tiền mặt</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="GiamToiDa" class="form-label fw-bold">Giảm tối đa</label>
                <input asp-for="GiamToiDa" type="number" step="0.01" class="form-control"
                       placeholder="VD: 10 (Phần trăm) hoặc 50000 (Tiền mặt)" min="0" />
                <span asp-validation-for="GiamToiDa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GiaTriToiThieu" class="form-label fw-bold">Giá trị đơn tối thiểu</label>
                <input asp-for="GiaTriToiThieu" type="number" step="1000" class="form-control"
                       placeholder="VD: 300000" min="0" />
                <span asp-validation-for="GiaTriToiThieu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HangApDung" class="form-label fw-bold">Hạng áp dụng</label>
                <select asp-for="HangApDung" class="form-select">
                    <option value="Tất cả">Tất cả</option>
                    <option value="Thường">Thường</option>
                    <option value="Bạc">Bạc</option>
                    <option value="Vàng">Vàng</option>
                    <option value="Bạch Kim">Bạch Kim</option>
                    <option value="Kim Cương">Kim Cương</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="NgayTao" class="form-label fw-bold">Ngày tạo</label>
                <input asp-for="NgayTao" type="date" class="form-control" />
                <span asp-validation-for="NgayTao" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="NgayHetHan" class="form-label fw-bold">Ngày hết hạn</label>
                <input asp-for="NgayHetHan" type="date" class="form-control" />
                <span asp-validation-for="NgayHetHan" class="text-danger"></span>
                <small class="text-muted">Để trống nếu không giới hạn thời gian</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-1"></i> Tạo voucher
                </button>
                <a asp-area="Admin" asp-controller="Voucher" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
