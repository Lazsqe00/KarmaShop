@model KarmaShop.Models.Voucher
@{
    ViewBag.Title = "Chi tiết voucher";
    var today = DateOnly.FromDateTime(DateTime.Today);
    bool conHan = Model.NgayHetHan == null || Model.NgayHetHan >= today;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-info-circle me-2"></i>CHI TIẾT VOUCHER</h3>
    <div>
        <a asp-area="Admin" asp-controller="Voucher" asp-action="Edit"
           asp-route-id="@Model.MaVoucher" class="btn btn-warning me-2">
            <i class="fas fa-edit me-1"></i> Sửa
        </a>
        <a asp-area="Admin" asp-controller="Voucher" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-header @(conHan ? "bg-success" : "bg-secondary") text-white">
        <h5 class="mb-0">
            @Model.MaVoucher
            <span class="badge bg-light text-dark ms-2">@(conHan ? "Còn hạn" : "Hết hạn")</span>
        </h5>
    </div>
    <div class="card-body">
        <table class="table table-borderless">
            <tr>
                <td class="fw-bold" style="width:40%">Mã Voucher:</td>
                <td><strong class="text-primary fs-5">@Model.MaVoucher</strong></td>
            </tr>
            <tr>
                <td class="fw-bold">Số lượng còn lại:</td>
                <td>@Model.SoLuong</td>
            </tr>
            <tr>
                <td class="fw-bold">Giảm tối đa:</td>
                <td class="text-success fw-bold">@Model.GiamToiDa?.ToString("0.##")%</td>
            </tr>
            <tr>
                <td class="fw-bold">Ngày tạo:</td>
                <td>@(Model.NgayTao?.ToString("dd/MM/yyyy") ?? "—")</td>
            </tr>
            <tr>
                <td class="fw-bold">Ngày hết hạn:</td>
                <td>@(Model.NgayHetHan?.ToString("dd/MM/yyyy") ?? "Không giới hạn")</td>
            </tr>
        </table>
    </div>
</div>
