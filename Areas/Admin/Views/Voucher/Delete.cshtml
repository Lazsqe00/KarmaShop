@model KarmaShop.Models.Voucher
@{
    ViewBag.Title = "Xóa voucher";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0 text-danger"><i class="fas fa-trash me-2"></i>XÓA VOUCHER</h3>
    <a asp-area="Admin" asp-controller="Voucher" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm border-danger" style="max-width:600px">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Xác nhận xóa voucher: @Model.MaVoucher</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Bạn có chắc muốn xóa voucher <strong>@Model.MaVoucher</strong>? Hành động này không thể hoàn tác.
        </div>
        <table class="table table-borderless">
            <tr>
                <td class="fw-bold" style="width:40%">Mã Voucher:</td>
                <td><strong class="text-primary">@Model.MaVoucher</strong></td>
            </tr>
            <tr>
                <td class="fw-bold">Số lượng:</td>
                <td>@Model.SoLuong</td>
            </tr>
            <tr>
                <td class="fw-bold">Giảm tối đa:</td>
                <td>@Model.GiamToiDa?.ToString("0.##")%</td>
            </tr>
            <tr>
                <td class="fw-bold">Ngày hết hạn:</td>
                <td>@(Model.NgayHetHan?.ToString("dd/MM/yyyy") ?? "Không giới hạn")</td>
            </tr>
        </table>
        <form asp-area="Admin" asp-controller="Voucher" asp-action="Delete"
              asp-route-id="@Model.MaVoucher" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i> Xác nhận xóa
                </button>
                <a asp-area="Admin" asp-controller="Voucher" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
