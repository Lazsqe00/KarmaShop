@{
    Layout = null;
}
@model KarmaShop.Models.TaiKhoan

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>KARMA Login</title>
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/LayoutAdmin/assets/css/style.css">
    <link rel="shortcut icon" href="~/karma-master/img/logo.png" />
</head>
<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth">
                <div class="row flex-grow">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left p-5">
                            <div class="brand-logo text-center mb-4">
                                <img src="~/karma-master/img/logo.png" alt="Logo" style="max-height: 60px;" />
                            </div>
                            <h4>Hello! let's get started</h4>
                            <h6 class="font-weight-light">Sign in to continue.</h6>

                            <form asp-area="Admin" asp-controller="TaiKhoanAdmin" asp-action="Login" method="post" class="pt-3">
                                @Html.AntiForgeryToken()

                                <div class="form-group">
                                    <input asp-for="Email" class="form-control form-control-lg"
                                           placeholder="Email" type="email" required autofocus />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <input asp-for="MatKhau" type="password" class="form-control form-control-lg"
                                           placeholder="Password" required />
                                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                                </div>

                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert alert-danger">
                                        <strong>Lỗi:</strong> @ViewBag.Error
                                    </div>
                                }

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-block btn-lg font-weight-medium auth-form-btn custom-btn">
                                        LOG IN
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/LayoutAdmin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/LayoutAdmin/assets/js/off-canvas.js"></script>
    <script src="~/LayoutAdmin/assets/js/hoverable-collapse.js"></script>
    <script src="~/LayoutAdmin/assets/js/misc.js"></script>
</body>
</html>
