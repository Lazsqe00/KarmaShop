@model IEnumerable<KarmaShop.Models.NhanVien>
@{
    ViewBag.Title = "Quản lý nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-users me-2"></i>QUẢN LÝ NHÂN VIÊN</h3>
    <a asp-area="Admin" asp-controller="NhanVien" asp-action="Create" class="btn btn-success">
        <i class="fas fa-user-plus me-1"></i> Thêm nhân viên
    </a>
</div>

<!-- Tìm kiếm -->
<form method="get" asp-area="Admin" asp-controller="NhanVien" asp-action="Index" class="mb-4">
    <div class="input-group" style="max-width: 500px;">
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
               placeholder="Tìm theo tên, email, SĐT..." />
        <button class="btn btn-primary" type="submit">
            <i class="fas fa-search"></i>
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.TuKhoa as string))
        {
            <a asp-area="Admin" asp-controller="NhanVien" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i> Xóa lọc
            </a>
        }
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th class="text-center">STT</th>
                <th>Tên nhân viên</th>
                <th>Email</th>
                <th class="text-center">SĐT</th>
                <th class="text-center">Giới tính</th>
                <th class="text-center">Ngày sinh</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @{int stt = 1;}
            @foreach (var nv in Model)
            {
                <tr>
                    <td class="text-center">@stt</td>
                    <td><strong>@nv.TenNhanVien</strong></td>
                    <td>@nv.Email</td>
                    <td class="text-center">@nv.SoDienThoai</td>
                    <td class="text-center">@nv.GioiTinh</td>
                    <td class="text-center">@nv.NgaySinh?.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-area="Admin" asp-controller="NhanVien" asp-action="Details"
                               asp-route-id="@nv.MaNhanVien" class="btn btn-info btn-sm text-white" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="NhanVien" asp-action="Edit"
                               asp-route-id="@nv.MaNhanVien" class="btn btn-warning btn-sm" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="NhanVien" asp-action="Delete"
                               asp-route-id="@nv.MaNhanVien" class="btn btn-danger btn-sm" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                stt++;
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy nhân viên nào.</td></tr>
            }
        </tbody>
    </table>
</div>
