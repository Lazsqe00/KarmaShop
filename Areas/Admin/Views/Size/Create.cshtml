@model KarmaShop.Models.Size
@{
    ViewBag.Title = "Thêm size mới";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-plus-circle me-2"></i>THÊM SIZE MỚI</h3>
    <a asp-area="Admin" asp-controller="Size" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Thông tin size</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Size" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="TenSize" class="form-label fw-bold">Tên size <span class="text-danger">*</span></label>
                <input asp-for="TenSize" class="form-control" required placeholder="VD: 40, 41, 42..." />
                <span asp-validation-for="TenSize" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-1"></i> Lưu
                </button>
                <a asp-area="Admin" asp-controller="Size" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
