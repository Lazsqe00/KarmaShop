@model IEnumerable<KarmaShop.Models.Size>
@{
    ViewBag.Title = "Quản lý size";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-ruler me-2"></i>QUẢN LÝ SIZE</h3>
    <a asp-area="Admin" asp-controller="Size" asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> Thêm size mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th class="text-center" style="width:80px">STT</th>
                <th class="text-center" style="width:100px">Mã size</th>
                <th>Tên size</th>
                <th class="text-center" style="width:200px">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @{int stt = (ViewBag.CurrentPage - 1) * 10 + 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@stt</td>
                    <td class="text-center"><code>@item.MaSize</code></td>
                    <td>@item.TenSize</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-area="Admin" asp-controller="Size" asp-action="Details"
                               asp-route-id="@item.MaSize" class="btn btn-info btn-sm text-white">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Size" asp-action="Edit"
                               asp-route-id="@item.MaSize" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-area="Admin" asp-controller="Size" asp-action="Delete"
                               asp-route-id="@item.MaSize" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                stt++;
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Chưa có size nào.</td></tr>
            }
        </tbody>
    </table>
</div>

@{
    int cur = ViewBag.CurrentPage;
    int tot = ViewBag.TotalPages;
}
@if (tot > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(cur == 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Size" asp-action="Index" asp-route-page="@(cur - 1)">«</a>
            </li>
            @for (int p = Math.Max(1, cur - 2); p <= Math.Min(tot, cur + 2); p++)
            {
                <li class="page-item @(p == cur ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Size" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(cur == tot ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-controller="Size" asp-action="Index" asp-route-page="@(cur + 1)">»</a>
            </li>
        </ul>
    </nav>
}
