@model KarmaShop.Models.Size
@{
    ViewBag.Title = "Sửa size";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h3 class="fw-bold mb-0"><i class="fas fa-edit me-2"></i>SỬA SIZE</h3>
    <a asp-area="Admin" asp-controller="Size" asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-header bg-warning">
        <h5 class="mb-0">Mã size: #@Model.MaSize</h5>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Size" asp-action="Edit"
              asp-route-id="@Model.MaSize" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="MaSize" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="TenSize" class="form-label fw-bold">Tên size</label>
                <input asp-for="TenSize" class="form-control" />
                <span asp-validation-for="TenSize" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save me-1"></i> Lưu
                </button>
                <a asp-area="Admin" asp-controller="Size" asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
